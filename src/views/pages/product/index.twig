{#
| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page                       | object      |                                                                      |
| page.title                 | string      | *could be html                                                       |
| page.slug                  | string      | ex: "cat.show"                                                       |
| category                   | ?Category   |                                                                      |
| category.name              | string      |                                                                      |
| category.url               | string      |                                                                      |
| category.sub_categories    | ?Category[] |                                                                      |
| category.image             | ?string     |                                                                      |
| filters                     | bool        | is filters allowed here or not                                        |
| sort_options[]             | SortList[]  |                                                                      |
| sort_options[].id          | string      | ourSuggest, bestSell, topRated, priceFromTopToLow, priceFromLowToTop |
| sort_options[].name        | string      |                                                                      |
| sort_options[].is_selected | bool        | Is current page sorted by it                                         |
| search_query               | ?string     |                                                                      |
#}
{% extends "layouts.master" %}
{% block content %}
	{% if theme.settings.get('product_index_show_breadcrumbs', true) %}
		<div class="wrap" style="padding-top:30px;padding-bottom:10px">
			{# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
			<nav class="breadcrumbs w-full py-5">
				<salla-breadcrumb></salla-breadcrumb>
			</nav>
		</div>
	{% endif %}

	{#
    Hook: product.index.before_products_group_with_filter
    Fires before the products grid and filter sidebar wrapper.
    Use this hook to inject content above the products listing area.
  #}
	<div class="s-blocks-wrapper s-before-products-list !mt-0">{% hook 'product.index.before_products_group_with_filter' %}</div>

	<div class="wrap s-products-index flex items-start flex-col md:flex-row" style="padding-bottom:90px">
		{% if filters %}
			<button type="button" aria-label="إغلاق الفلاتر" class="btn--close-sm close-filters sicon-cancel hidden"></button>
			<salla-filters data-testid="store-products-filters" class="md:w-72 lg:sticky lg:top-24 flex-none" id="filters-menu"></salla-filters>
		{% endif %}

		<div class="main-content flex-1 w-full {{ filters ? 'ltr:lg:ml-8 rtl:lg:mr-8' : '' }}">
			{#
			    A short, genuine description per known section (same copy
			    already used for its homepage preview) instead of a bare
			    title - matched off category.name since that's the only
			    per-page signal this generic template gets. Any category
			    outside this known list (the merchant's own categories once
			    the store is live on Salla) just shows the title alone.
			#}
			{% set category_subtitle = null %}
			{% if category.name == 'فئات شحن العملات' or category.name == 'اختر عملاتك' %}
				{% set category_subtitle = 'فئات عملات متنوعة تناسب احتياجك، ونضيف المزيد تباعًا.' %}
			{% elseif category.name == 'العروض' %}
				{% set category_subtitle = trans('bav.offers_subtitle') %}
			{% elseif category.name == 'الدبل CP' %}
				{% set category_subtitle = trans('bav.double_cp_subtitle') %}
			{% elseif category.name == 'إهداء الدبل CP' %}
				{% set category_subtitle = trans('bav.double_cp_gift_subtitle') %}
			{% elseif category.name == 'الملفات الرقمية' %}
				{% set category_subtitle = trans('bav.digital_files_subtitle') %}
			{% elseif category.name == 'الخدمات' %}
				{% set category_subtitle = trans('bav.services_subtitle') %}
			{% endif %}
			<div class="mb-6 sm:mb-8 flex justify-between items-center flex-wrap gap-4">
				<div>
					<h1 class="disp" style="font-size:32px" id="page-main-title">{{ page.title|raw }}</h1>
					{% if category_subtitle %}
						<p style="font-size:15px;color:#9B9BA5;margin-top:8px;max-width:520px">{{ category_subtitle }}</p>
					{% endif %}
				</div>
				<div class="flex items-center gap-3">
					{% if filters %}
						<a data-testid="store-products-filters-mobile-trigger" href="#filters-menu" aria-label="تصفية المنتجات" aria-controls="filters-menu" aria-expanded="false" class="filters-trigger ico lg:hidden" style="width:46px;height:46px;border-radius:14px">
							<i class="sicon-filter text-2xl"></i>
						</a>
					{% endif %}
					{% if sort_options|length %}
						<div class="flex items-center gap-3">
							<label class="hidden sm:block whitespace-nowrap" style="color:#9B9BA5;font-size:14px" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
							<select id="product-filter" style="height:48px;min-width:170px;border-radius:14px;border:1px solid #2E2E35;background:#0E0E11;color:#F4F4F2;font-family:inherit;font-size:15px;font-weight:500;padding:0 16px;outline:0">
								{% for sort in sort_options %}
									<option value="{{ sort.id }}" {{ sort.is_selected?'selected':'' }}>{{ sort.name }}</option>
								{% endfor %}
							</select>
						</div>
					{% endif %}
				</div>
			</div>

			{% hook 'product:index.items.start' %}

			{# nothing is marked selected when the store default sort is disabled, so send the shown option with the first request #}
			{% set sort_list = sort_options|default([]) %}
			{% set first_sort = sort_list|first %}
			{% set has_selected_sort = 0 %}
			{% for sort in sort_list %}{% if sort.is_selected %}{% set has_selected_sort = has_selected_sort + 1 %}{% endif %}{% endfor %}
			{% set fallback_sort = (sort_list|length and not has_selected_sort and first_sort.id != 'ourSuggest') ? first_sort.id : '' %}

			<div class="s-products-index-grid">
				<salla-products-list data-testid="store-products-list" class="flex-1 min-w-0" source="{{ page.slug }}" source-value="{{ page.id }}" sort-by="{{ fallback_sort }}" {{ filters ?'filters-Results':'' }}></salla-products-list>
			</div>

			{% hook 'product:index.items.end' %}
		</div>
	</div>

	{#
    Hook: product.index.after_products_group_with_filter
    Fires after the products grid and filter sidebar wrapper.
    Use this hook to inject content below the products listing area.
  #}
	<div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

	{% if store.settings.category.testimonial_enabled %}
		{% component 'home.testimonials' %}
	{% endif %}

	{#
    Hook: product.index.after_testimonials
    Fires after the testimonials (store reviews) section.
    Use this hook to inject content below the testimonials area.
  #}
	<div class="s-blocks-wrapper s-after-testimonials">{% hook 'product.index.after_testimonials' %}</div>
{% endblock %}

{% block scripts %}
	<script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
