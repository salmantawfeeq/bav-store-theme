{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|--------------------------------------------------------------------------|
| page                                   | object                      |                                                                        |
| page.title                             | string                      | *could be html                                                         |
| page.slug                              | string                      | ex: "cat.show"                                                         |
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.weight                         | ?string                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.barcode                        | ?string                     |                                                                        |
| product.shows_sku                      | bool                        | SKU row belongs on the page (selected, and a value exists somewhere)   |
| product.shows_barcode                  | bool                        | Barcode row belongs on the page (selected, and a value exists)         |
| product.rating                         | ?Rating                     |                                                                        |
| product.rating.count                   | int                         |                                                                        |
| product.rating.stars                   | int                         |                                                                        |
| product.price                          | float                       | can be string too `-`, when merchant doesn't want to show zero         |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.quantity                       | ?int                        | if it's null, means it's unlimited                                     |
| product.sold_quantity                  | int                         |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.discount_ends                  | ?date                       |                                                                        |
| product.is_taxable                     | bool                        | Is the tax included in the price                                       |
| product.category                       | ?Category                   |                                                                        |
| product.category.name                  | string                      |                                                                        |
| product.category.url                   | string                      |                                                                        |
| product.image                          | object                      |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.image.alt                      | ?string                     |                                                                        |
| product.images                         | array                       |                                                                        |
| product.images[].id                    | int                         |                                                                        |
| product.images[].url                   | string                      |                                                                        |
| product.images[].alt                   | ?string                     |                                                                        |
| product.images[].video_url             | ?string                     |                                                                        |
| product.images[].video_type            | ?string                     | 'video' 'youtube'                                                      |
| product.images[].type                  | string                      | `image` `video`                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.tags                           | ?Tags[] *Collection         |                                                                        |
| product.options                        | ProductOption[] *Collection | @see views/pages/partials/product/options.twig                         |
| product.notify_availability            | ?object                     | does product outOfStock & can visitor subscribe to notify availability |
| product.donation                       | ?ProductDonation            |                                                                        |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.is_on_sale                     | bool                        | Product has discounted price                                           |
| product.is_hidden_quantity             | bool                        | The quantity is hidden by merchant, or product not available           |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.base_currency_price            | float                       | product.price with base currency (SAR)                                 |
| product.discount_percentage            | ?string                     | ex: "20%"                                                              |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.currency                       | string                      |                                                                        |

    Bav product page: same real data/components Salla's default theme uses
    (so price updates, option validation, SKU/barcode toggling and stock
    handling in product.js keep working untouched) re-skinned to the Bav
    dark design. No game name is ever printed here — only the merchant's
    own category/product naming, which is generic by design.
#}
{% extends "layouts.master" %}
{% block content %}
    {% set fulfillment_time = theme.settings.get('execution_time_text')|default('من 10 دقائق إلى ساعتين ونصف بعد تأكيد الدفع') %}
    {% set is_technical_service = 'خدمات' in (product.category.name ?? '') %}
    {#
        Salla's icon font only has one heart glyph (no separate filled/
        outline variants) - swapping its colour alone on "liked" left the
        glyph itself looking unchanged in the heart's body, only its thin
        stroke picking up the accent colour. This SVG is a genuinely solid
        heart shown only in the .is-added state (CSS swap, see bav.scss),
        so the whole heart visibly fills with colour, not just an outline.
    #}
    {% set bav_heart_filled_svg %}<svg class="bav-heart-filled" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 21.35c-.3 0-.59-.1-.83-.28C7.14 18 2 13.36 2 8.86 2 5.42 4.42 3 7.86 3c1.74 0 3.41.86 4.14 2.22C12.73 3.86 14.4 3 16.14 3 19.58 3 22 5.42 22 8.86c0 4.5-5.14 9.14-9.17 12.21-.24.18-.53.28-.83.28z"/></svg>{% endset %}
    {#
        Wrapped-box ribbon for gift products (identical markup also lives in
        product-card.js and scripts/preview-mock-data.js - keep all three in
        sync if this changes). Sizes itself in % of its container via
        .bav-gift-ribbon in bav.scss, so it works on both the card thumbnail
        and this full-size gallery image.
    #}
    {% set bav_gift_ribbon_svg %}<div class="bav-gift-ribbon" aria-hidden="true">
        <span class="bav-gift-ribbon__v"></span>
        <span class="bav-gift-ribbon__h"></span>
        <span class="bav-gift-ribbon__bow"><svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <path d="M50 52C38 34 12 32 8 48c-3 14 16 20 42 4Z" fill="#D7352B"/>
            <path d="M50 52C62 34 88 32 92 48c3 14-16 20-42 4Z" fill="#D7352B"/>
            <path d="M50 52C40 40 20 39 14 48c-2 6 8 10 36 4Z" fill="#fff" opacity=".18"/>
            <path d="M50 52C60 40 80 39 86 48c2 6-8 10-36 4Z" fill="#000" opacity=".15"/>
            <path d="M44 58L38 94L48 84Z" fill="#A61B12"/>
            <path d="M56 58L62 94L52 84Z" fill="#A61B12"/>
            <rect x="42" y="42" width="16" height="16" rx="3" fill="#A61B12" transform="rotate(45 50 50)"/>
            <rect x="42" y="42" width="16" height="16" rx="3" fill="none" stroke="#7A1210" stroke-width="1.5" transform="rotate(45 50 50)"/>
        </svg></span>
    </div>{% endset %}
    {% if theme.settings.get('product_show_breadcrumbs', true) %}
      <div class="container container--breadcrumbs">
          <nav class="breadcrumbs w-full py-5">
              <salla-breadcrumb></salla-breadcrumb>
          </nav>
      </div>
    {% endif %}

    <div class="s-blocks-wrapper s-before-product-info !mt-0">{% hook 'product.single.before_product_info' %}</div>

    <div class="container container--product-details">
        <div class="split" id="product-{{ product.id }}">
            <div class="sidebar" style="position:sticky;top:20px">
                {#
                    Gallery is intentionally limited to exactly 2 slides (merchant spec):
                    1) the product's own real cover image, 2) one fixed, theme-wide
                    schematic illustration (not a game screenshot) showing where the
                    player ID lives. Same explainer slide on every product page -
                    except gift/"إهداء" products, where the customer needs the
                    RECIPIENT's id, not their own, so a second schematic explains
                    that instead. Detected off product.options[].name (a real,
                    merchant-configured field) containing "المستلم" - exactly the
                    option name طلبات_صاحب_المتجر.md has Salman set up for these
                    products - rather than guessing from the product's name/slug.
                #}
                {% set is_recipient_id_product = false %}
                {% set is_player_id_product = false %}
                {% for opt in product.options|default([]) %}
                    {% if 'المستلم' in opt.name %}{% set is_recipient_id_product = true %}{% endif %}
                    {% if 'معرّف اللاعب' in opt.name or 'معرف اللاعب' in opt.name %}{% set is_player_id_product = true %}{% endif %}
                {% endfor %}
                {#
                    Double CP (regular and gift) looked identical to a plain
                    CP tier at a glance - same coin render, no visual cue
                    this one doubles the amount. Detected off the product's
                    own category name (set by Salman in Salla, "الدبل CP" /
                    "إهداء الدبل CP") rather than slug, same convention as
                    the recipient-id detection above.
                #}
                {% set is_double_cp_product = 'الدبل' in (product.category.name ?? '') %}
                {% set explainer_image = is_recipient_id_product
                    ? {id: 'recipient-id-explainer', url: 'images/recipient-id-schematic.svg'|asset, alt: 'معرّف المستلم: ادخل على الحساب الشخصي لصديقك، وانسخ الآيدي', video_url: null, video_type: null, type: 'image'}
                    : {id: 'player-id-explainer', url: 'images/player-id-schematic.svg'|asset, alt: 'رسم توضيحي يوضح مكان معرّف اللاعب: الإعدادات، ثم إعدادات المستخدم، ثم نسخ المعرّف', video_url: null, video_type: null, type: 'image'} %}
                {#
                    Only "codes" products (currency tiers, Battle Pass,
                    Double CP) actually ask for a player ID / recipient ID -
                    digital files ask for an email instead, and services
                    have no fixed required field at all, so this schematic
                    was showing up as an irrelevant second photo on every
                    product page regardless of type.
                #}
                {% set gallery_images = (product.type == 'codes' or is_player_id_product or is_recipient_id_product) ? product.images|slice(0, 1)|merge([explainer_image]) : product.images|slice(0, 2) %}
                {% set has_many_images = true %}
                <salla-slider
                        data-testid="store-product-image-slider"
                        id="details-slider-{{ product.id }}"
                        class="details-slider rounded-md image-slider"
                        data-images='{{ gallery_images|json_encode }}'
                        type="thumbs"
                        loop="false"
                        auto-height
                        listen-to-thumbnails-option
                        show-thumbs-controls="false"
                        style="border-radius:26px;overflow:hidden;border:1px solid #232329;display:block">
                    {% if product.promotion_title %}
                        <div class="promotion-title badge">{{ product.promotion_title }}</div>
                    {% endif %}
                    {% if product.discount_percentage %}
                        <span class="save num" dir="ltr" style="position:absolute;top:16px;left:16px;z-index:2">-{{ product.discount_percentage }}</span>
                    {% endif %}
                    {% if is_recipient_id_product %}
                        {{ bav_gift_ribbon_svg }}
                    {% endif %}
                    {% if is_double_cp_product %}
                        <span class="bav-x2-badge" aria-hidden="true">×2</span>
                    {% endif %}

                    <salla-button
                            class="btn--wishlist animated sws"
                            data-id="{{ product.id }}"
                            data-testid="store-product-wishlist-btn-gallery"
                            onclick="salla.wishlist.toggle('{{ product.id }}')"
                            shape="icon"
                            fill="outline"
                            color="light">
                        <i class="sicon-heart"></i>
                        {{ bav_heart_filled_svg }}
                    </salla-button>

                    {# Full-bleed banner-style covers (digital guides) are designed at
                       their own aspect ratio with text near the edges — contain shows
                       the whole cover instead of cropping it like a product photo. #}
                    {% set image_fit = product.type == 'digital' ? 'object-contain' : 'object-cover' %}
                    <div slot="items">
                        {% for image in gallery_images %}
                            <a data-fslightbox="product_{{ product.id }}"
                               data-img-id="{{ image.id }}"
                               data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                               data-caption="{{ image.alt }}"
                               data-infinite="false"
                               data-type="{{ image.video_type ?? 'image' }}"
                               href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                               aria-label="{{ product.name }}"
                               class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                {% if loop.first %}
                                    <img id="{{image.id}}" fetchpriority="high" loading="eager" src="{{ image.url }}"
                                         alt="{{ image.alt }}" class="h-full {{ image_fit }} w-full">
                                {% else %}
                                    <img id="{{image.id}}" src="{{ image.url }}" loading="lazy"
                                         alt="{{ image.alt }}" class="h-full object-contain w-full">
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>

                    {% if has_many_images %}
                        <div data-testid="store-product-thumbnails" slot="thumbs" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:14px">
                            {% for image in gallery_images %}
                                <div class="thumb {{ loop.first ? 'on' : '' }} {{ image.video_url?'video-entry':'' }}" data-caption="{{ image.alt }}">
                                    <img src="{{ image.url }}" loading="lazy" title="{{ image.alt }}" alt="{{ image.alt }}"/>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </salla-slider>
            </div>

            <div class="main-content" style="display:flex;flex-direction:column;gap:30px">
                {% hook 'product:single.description.start' %}

                <div>
                {% if product.brand.name %}
                    <div class="product-brand mb-5 w-12">
                        <a class="brand-logo" href="{{ product.brand.url }}" title="{{ product.brand.name }}">
                            <img width="100%" height="100%" class="max-h-full object-contain" src="{{ product.brand.logo }}" title="{{ product.brand.name }}" alt="{{ product.brand.name }}">
                        </a>
                    </div>
                {% endif %}

                {% if product.category.name %}
                    <a href="{{ product.category.url }}" class="product-eyebrow">{{ product.category.name }}</a>
                {% endif %}

                <h1 data-testid="store-product-title" class="disp p-h1">{{ product.name }}</h1>

                {% if product.subtitle %}
                    <h2 class="psub" style="font-size:15px;margin-top:10px">{{ product.subtitle }}</h2>
                {% endif %}

                {% if product.rating %}
                    <salla-rating-stars data-testid="store-product-rating" value="{{ product.rating.stars }}" reviews="{{ product.rating.count }}" style="margin-top:14px"></salla-rating-stars>
                {% endif %}

                {% if product.is_taxable %}
                    <small style="color:#7C7C86">{{ trans('pages.products.tax_included') }}</small>
                {% endif %}

                <div data-testid="store-product-price" class="prow" style="margin-top:18px;flex-wrap:wrap">
                  <div class="bav-price-row-sale {{ product.is_on_sale ? '' : 'hidden' }}">
                      <span class="price num" style="font-size:44px">{{ product.sale_price|money }}</span>
                      <s class="old">{{ product.regular_price|money }}</s>
                      {% if product.is_on_sale %}
                        {% set saved = product.regular_price - product.sale_price %}
                        <span class="save-badge">{{ trans('bav.product.you_saved', {amount: saved|money}) }}</span>
                      {% endif %}
                  </div>
                  <div class="bav-price-row {{ product.is_on_sale ? 'hidden' : '' }}">
                      {% if product.starting_price %}
                          <span style="font-size:15px;color:#8E8E98">{{ trans('pages.products.starting_price') }}</span>
                      {% endif %}
                      <span class="price num" style="font-size:44px">{{ product.starting_price ? product.starting_price|money : product.price|money }}</span>
                  </div>
                </div>
                {% if product.type == 'digital' %}
                    <div style="margin-top:10px;font-size:14px;color:#C7C7CE">{{ trans('bav.digital_no_refund_note') }}</div>
                {% endif %}
                </div>

                <div data-testid="store-product-description" class="product__description">
                    {% set product_desc = product.description|replace({"&nbsp;":"\n"}) %}
                    {% if product.has_read_more %}
                        <article class="article article--main relative leading-8 overflow-hidden transition-all max-h-0 duration-300 py-4" id="more-content" style="max-height:5.25rem;color:#A6A6AF;line-height:1.9">
                            {{ product_desc|raw }}
                        </article>
                        <a id="btn-show-more" class="link--primary inline-block mt-2 cursor-pointer" style="color:var(--accent);font-weight:600">
                            {{ trans('pages.products.read_more') }}
                        </a>
                    {% else %}
                        <article class="article--main" style="color:#A6A6AF;line-height:1.9">
                            {{ product_desc|raw }}
                        </article>
                    {% endif %}
                </div>
                <div style="display:flex;flex-direction:column;gap:14px">
                {% if product.tags|length and theme.settings.get('show_tags', true) %}
                    <div>
                        {% for tag in product.tags %}
                            <a href="{{ tag.url }}" style="color:#9B9BA5;text-decoration:underline;font-size:14px;margin-left:8px">{{ tag.name }},</a>
                        {% endfor %}
                    </div>
                {% endif %}

                <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                    <salla-social-share data-testid="store-product-social-share" class="ico" style="width:46px;height:46px;border-radius:14px" aria-label="social share"></salla-social-share>
                    <salla-button
                            data-testid="store-product-wishlist-btn"
                            class="btn--wishlist animated"
                            data-id="{{ product.id }}"
                            onclick="salla.wishlist.toggle('{{ product.id }}')"
                            shape="icon"
                            fill="outline"
                            color="light"
                            aria-label="add to wishlist">
                        <i class="sicon-heart"></i>
                        {{ bav_heart_filled_svg }}
                    </salla-button>
                </div>

                {% if product.sold_quantity or product.can_show_remained_quantity %}
                    <div style="display:inline-flex;gap:8px;background:var(--bg-surface-1);border:1px solid var(--border-1);padding:10px 4px;border-radius:14px;font-size:14px">
                        {% if product.sold_quantity %}
                            <div style="padding:0 16px;color:#FF6B5A">
                                <i class="sicon-fire" style="margin-left:6px"></i>{{ trans('pages.products.sold') }}
                                <span>{{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}</span>
                            </div>
                        {% endif %}
                        {% if product.can_show_remained_quantity %}
                            <div style="padding:0 16px;border-right:1px solid var(--border-1)">
                                <i class="sicon-box-bankers" style="color:#FF6B5A;margin-left:6px"></i>
                                {{ trans('pages.products.remained') }}
                                <span>{{ product.quantity }}</span>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {% if product.shows_sku %}
                    <div class="product-sku-wrapper mb-4 {% if not product.sku %}hidden{% endif %}">
                        <div style="display:flex;justify-content:space-between;background:var(--bg-surface-1);border:1px solid var(--border-1);border-radius:14px;padding:12px 16px">
                            <div style="display:flex;align-items:center"><i class="sicon-barcode" style="margin:0 6px"></i>{{ trans('pages.products.sku') }}</div>
                            <div class="text-unicode break-all product-sku">{{ product.sku }}</div>
                        </div>
                    </div>
                {% endif %}
                {% if product.shows_barcode %}
                    <div class="product-barcode-wrapper mb-4 {% if not product.barcode %}hidden{% endif %}">
                        <div style="display:flex;justify-content:space-between;background:var(--bg-surface-1);border:1px solid var(--border-1);border-radius:14px;padding:12px 16px">
                            <div style="display:flex;align-items:center"><i class="sicon-barcode" style="margin:0 6px"></i>{{ trans('pages.products.barcode') }}</div>
                            <div class="text-unicode break-all product-barcode">{{ product.barcode }}</div>
                        </div>
                    </div>
                {% endif %}
                {% hook 'product:single.description' %}

                <salla-installment data-testid="store-product-installment" price="{{ product.price }}"></salla-installment>
                {% if product.has_metadata %}
                    <salla-metadata data-testid="store-product-metadata"></salla-metadata>
                {% endif %}

                {% if product.show_availability %}
                    <section style="background:var(--bg-surface-1);border:1px solid var(--border-1);padding:20px;border-radius:14px;margin-bottom:20px">
                        <div class="center-between">
                            <label class="flex items-center text-base">
                                <span class="sicon-location" style="margin-left:6px"></span>
                                <span class="inline-block">{{ trans('pages.products.availability') }}</span>
                            </label>
                            <div class="mt-1 sm:mt-0 sm:col-span-2 text-end">
                                <a href="#!" onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })" style="color:var(--accent);display:flex;align-items:center">
                                    <span>{{ trans('pages.products.select_branch') }}</span>
                                    <span class="sicon-keyboard_arrow_left" style="margin-right:8px"></span>
                                </a>
                            </div>
                        </div>
                    </section>
                {% endif %}

                {% if product.digital_files_settings %}
                    <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
                {% endif %}

                <form data-testid="store-product-form" class="form product-form" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)">
                    <input type="hidden" name="id" value="{{ product.id }}">

                    {% hook 'product:single.form.start' %}

                    {#
                        The placeholder text inside each option field (set by
                        the merchant per-field in Salla's own dashboard, see
                        طلبات_صاحب_المتجر.md) disappears the moment a shopper
                        starts typing or taps the field - easy to mistake for
                        their own already-saved data instead of a sample. A
                        persistent "مثال:" line above the real field, built
                        from each option's own real placeholder value rather
                        than a hardcoded guess, stays visible the whole time.
                    #}
                    {% for opt in product.options|default([]) %}
                        {% if opt.placeholder and ('معرّف' in opt.name or 'معرف' in opt.name or 'آيدي' in opt.name) %}
                            <p style="font-size:13px;color:#8E8E98;margin:-4px 0 10px">{% if 'مثال' in opt.placeholder %}{{ opt.placeholder }}{% else %}{{ trans('bav.product.placeholder_example_note', {example: opt.placeholder}) }}{% endif %}</p>
                        {% endif %}
                    {% endfor %}
                    {% include 'pages.partials.product.options' %}

                    {% if product.has_options %}
                        <label class="chk" style="margin-top:16px;padding:18px 20px;border-radius:14px;border:1px solid var(--border-2);background:var(--bg-surface-4)">
                            <input id="confirm-ok" type="checkbox">
                            <span style="font-size:15px;line-height:1.8;color:#C7C7CF">
                                {{ trans('bav.product.confirm_label') }}
                                {#
                                    This "how to find id" link only makes sense for
                                    the player-ID / recipient-ID field on "codes"
                                    products (currency tiers, Battle Pass, Double CP).
                                    Digital files ask for an email and the
                                    "إنشاء حساب" service asks for email+phone - neither
                                    has a player ID at all, so the link was showing
                                    there too before this type check, pointing a
                                    confused shopper at an irrelevant help page.
                                #}
                                {% if product.type == 'codes' or is_player_id_product or is_recipient_id_product %}
                                    {% if is_recipient_id_product %}
                                        <a href="{{ theme.settings.get('find_recipient_id_page_url', store.url ~ '#how') }}" style="color:var(--accent);font-weight:600;display:inline-block;margin-top:6px">{{ trans('bav.find_recipient_id_title') }}</a>
                                    {% else %}
                                        <a href="{{ theme.settings.get('find_id_page_url', store.url ~ '#how') }}" style="color:var(--accent);font-weight:600;display:inline-block;margin-top:6px">{{ trans('bav.product.how_to_find_id') }}</a>
                                    {% endif %}
                                {% endif %}
                            </span>
                        </label>
                        <div class="pid-err" id="confirm-err" style="display:none">{{ trans('bav.product.confirm_required') }}</div>
                    {% endif %}

                    {% hook 'product:single.form.end' %}

                    <section style="background:var(--bg-surface-1);border:1px solid var(--border-1);padding:20px;border-radius:14px 14px 0 0;margin-top:20px">
                        <div class="center-between w-full">
                            <label class="form-label"><b class="block">{{ trans('pages.products.price') }}</b></label>
                            <div class="price-wrapper" style="display:flex;align-items:baseline;gap:12px">
                              <div class="price_is_on_sale {{ product.is_on_sale ? '' : 'hidden' }}" style="{{ product.is_on_sale ? 'display:flex;align-items:baseline;gap:10px' : '' }}">
                                <h2 class="total-price num" style="font-size:22px">{{ product.sale_price|money }}</h2>
                                <span class="before-price old">{{ product.regular_price|money }}</span>
                              </div>
                              <div class="starting-or-normal-price {{ product.is_on_sale ? 'hidden' : '' }}" style="{{ product.is_on_sale ? '' : 'display:flex;align-items:baseline;gap:10px' }}">
                                {% if product.starting_price %}
                                  <span class="starting-price-title" style="font-size:14px;color:#8E8E98">{{ trans('pages.products.starting_price') }}</span>
                                {% endif %}
                                <h2 class="total-price num" style="font-size:22px">{{ product.starting_price ? product.starting_price|money : product.price|money }}</h2>
                              </div>
                            </div>
                            <div data-testid="store-product-out-of-stock" class="out-of-stock hidden" style="color:#FF6B5A;font-weight:700">{{ trans('pages.products.out_of_stock')}}</div>
                        </div>
                    </section>

                    {% if product.has_preorder_campaign %}
                        <section style="padding:20px 0">
                            <salla-count-down data-testid="store-product-preorder-countdown" pre-order='{{ product.preorder|json_encode}}' boxed labeled></salla-count-down>
                        </section>
                    {% endif %}

                    <section class="sticky-product-bar" style="background:var(--bg-surface-1);border:1px solid var(--border-1);border-top:0;padding:20px;border-radius:0 0 14px 14px">
                        {% if product.is_hidden_quantity or product.type == 'booking' or product.type == 'digital' %}
                            <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                        {% else %}
                            <div class="sticky-product-bar__quantity center-between mb-5">
                                <label class="form-label font-bold">{{ trans('pages.products.quantity') }}</label>
                                <salla-quantity-input data-testid="store-product-quantity" max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"></salla-quantity-input>
                            </div>
                            <div class="center-between mb-5" style="padding-top:14px;border-top:1px solid var(--border-1)">
                                <span style="color:#9B9BA5;font-size:14px">{{ trans('bav.product.subtotal_label') }}</span>
                                <span class="num" id="bav-line-subtotal" style="font-size:20px;font-weight:700" data-unit-price="{{ product.is_on_sale ? product.sale_price : (product.starting_price ? product.starting_price : product.price) }}">{{ (product.is_on_sale ? product.sale_price : (product.starting_price ? product.starting_price : product.price))|money }}</span>
                            </div>
                        {% endif %}
                        <salla-add-product-button
                                data-testid="store-product-add-to-cart"
                                {{product.can_quick_buy ? 'quick-buy' : ''}}
                                {{theme.settings.get('sticky_add_to_cart') ? ' support-sticky-bar' : ''}}
                                {{product.is_require_shipping ? 'required-shipping' : ''}}
                                {{product.has_preorder_campaign ? 'has-pre-order' : ''}}
                                amount="{{ product.base_currency_price }}"
                                class="mt-5 w-full sticky-product-bar__btn"
                                product-status="{{ product.status }}"
                                product-type="{{ product.type }}"
                                product-id="{{ product.id }}"
                                loader-position="end"
                                type="submit"
                                width="wide"
                                {% if product.notify_availability %}
                                    {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                    channels="{{ product.notify_availability.channels|join(',') }}"
                                    subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                                    {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                {% endif %}>
                            {{ product.add_to_cart_label }}
                        </salla-add-product-button>
                    </section>

                    {% if product.is_giftable %}
                        <salla-gifting data-testid="store-product-gifting" class="mt-5" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : '' }}></salla-gifting>
                    {% endif %}
                </form>

                <div style="display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:14px;border:1px solid var(--border-3);background:rgba(255,255,255,.03);margin-top:16px">
                    <svg aria-hidden="true" style="flex:none" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    {% if product.type == 'digital' %}
                        <span style="font-size:15px;line-height:1.7;color:#C7C7CF">{{ trans('bav.product.instant_note') }}</span>
                    {% elseif is_technical_service %}
                        <span style="font-size:15px;line-height:1.7;color:#C7C7CF">{{ trans('bav.product.execution_note_service') }}</span>
                    {% else %}
                        <span style="font-size:15px;line-height:1.7;color:#C7C7CF">{{ trans('bav.product.execution_note', {time: fulfillment_time}) }}</span>
                    {% endif %}
                </div>

                {#
                    Double CP's "once per account" limit is a real restriction
                    from the top-up source itself (طلبات_صاحب_المتجر.md point 3
                    under "الدبل CP"), not a store policy - it was only ever
                    surfaced on the GIFT confirmation page, never on the
                    regular Double CP product itself where it applies just as
                    much (to the buyer's own account instead of a recipient's).
                #}
                {% if is_double_cp_product %}
                    <div style="display:flex;align-items:flex-start;gap:12px;padding:14px 18px;border-radius:14px;border:1px solid #3A2A14;background:#1A1208;margin-top:12px">
                        <i class="sicon-info" style="flex:none;color:var(--accent);font-size:20px;margin-top:2px"></i>
                        <span style="font-size:14.5px;line-height:1.8;color:#D8C9B8">{{ trans('bav.product.double_cp_once_warning') }}</span>
                    </div>
                {% endif %}

                {#
                    Mini weapons-charging calculator (طلبات_صاحب_المتجر.md,
                    "حاسبة شحن الأسلحة") - scoped to this one weapon, rendered
                    client-side by product.js into #bav-weapons-calculator-mini.
                    Detected the same way as is_double_cp_product above: off
                    the product's own category name, not its slug/name.
                #}
                {% if 'أسلحة' in (product.category.name ?? '') %}
                    {% set weapon_wheels = [] %}
                    {% for w in theme.settings.get('weapon_wheel_prices')|default([]) %}
                        {% set wheel_name = w['weapon_wheel_prices.name']|default(w.name) %}
                        {% set weapon_wheels = weapon_wheels|merge([{
                            id: (loop.index0 ~ ''),
                            label: (wheel_name is iterable ? wheel_name[language.code]|default(wheel_name|first) : wheel_name),
                            pulls: {
                                gulf: (w['weapon_wheel_prices.gulf_prices']|default(w.gulf_prices))|default('')|split(','),
                                medium: (w['weapon_wheel_prices.medium_prices']|default(w.medium_prices))|default('')|split(','),
                                african: (w['weapon_wheel_prices.african_prices']|default(w.african_prices))|default('')|split(',')
                            }
                        }]) %}
                    {% endfor %}
                    <div style="margin-top:20px">
                        <div class="disp" style="font-size:18px;margin-bottom:14px">{{ trans('bav.weapons_calculator_mini_title') }}</div>
                        <div id="bav-weapons-calculator-mini"
                             data-wheels='{{ weapon_wheels|json_encode }}'
                             data-lang-account-type="{{ trans('bav.wcalc_account_type') }}"
                             data-lang-pulls-label="{{ trans('bav.wcalc_pulls_label') }}"
                             data-lang-pulls-hint="{{ trans('bav.wcalc_pulls_hint') }}"
                             data-lang-include-all="{{ trans('bav.wcalc_include_all') }}"
                             data-lang-exclude-all="{{ trans('bav.wcalc_exclude_all') }}"
                             data-lang-owned-label="{{ trans('bav.wcalc_owned_label') }}"
                             data-lang-owned-note="{{ trans('bav.wcalc_owned_note') }}"
                             data-lang-discount-label="{{ trans('bav.wcalc_discount_label') }}"
                             data-lang-discount-note="{{ trans('bav.wcalc_discount_note') }}"
                             data-lang-result-label="{{ trans('bav.wcalc_result_label') }}"></div>
                    </div>
                {% endif %}

                {% hook 'product:single.description.end' %}
                <salla-quick-order data-testid="store-product-quick-order" class="mt-5 md:-mb-2 block"></salla-quick-order>
            </div>
        </div>
        <salla-offer data-testid="store-product-offer"></salla-offer>

        <div class="split" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));margin-top:84px">
            <div class="info"><div class="disp" style="font-size:22px">{{ trans('bav.product.before_buy_title') }}</div><p style="margin:12px 0 0;font-size:15px;line-height:1.9;color:#A6A6AF">{{ trans(product.type == 'digital' ? 'bav.product.before_buy_desc_digital' : (is_technical_service ? 'bav.product.before_buy_desc_service' : 'bav.product.before_buy_desc')) }}</p></div>
            <div class="info"><div class="disp" style="font-size:22px">{{ trans('bav.product.after_pay_title') }}</div><p style="margin:12px 0 0;font-size:15px;line-height:1.9;color:#A6A6AF">{{ product.type == 'digital' ? trans('bav.product.after_pay_desc_digital') : (is_technical_service ? trans('bav.product.after_pay_desc_service') : trans('bav.product.after_pay_desc', {time: fulfillment_time})) }}</p></div>
            <div class="info"><div class="disp" style="font-size:22px">{{ trans('bav.product.refund_title') }}</div><p style="margin:12px 0 0;font-size:15px;line-height:1.9;color:#A6A6AF">{{ trans('bav.product.refund_desc') }}</p></div>
        </div>
    </div>

    <div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>

    {% if store.settings.rating.show_on_product %}
        <salla-comments data-testid="store-product-comments" item-id="{{product.id}}" type="product"></salla-comments>
    {% endif %}

    <div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>

    <div class="container" style="margin-top:60px;margin-bottom:40px">
        <salla-products-slider data-testid="store-product-related" source="related" source-value="{{product.id}}" block-title="{{trans('pages.products.similar_products')}}" display-all-url></salla-products-slider>
    </div>

    <div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}
