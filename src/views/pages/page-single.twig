{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
| page.url     | string                |             |
| page.slug    | string                |             |
| page.type    | string                |             |
#}
{% extends "layouts.master" %}
{% block content %}
    {#
        Twilight has one fixed template for every merchant-created "informative
        page" (page.slug is always the same generic route id, never a unique
        per-page slug) - page.title is the only per-page signal available, so
        a few known, exact titles get this theme's own designed layout below.
        Create the matching pages in Salla's dashboard with these exact titles
        for the design to apply; any other page falls back to the plain
        generic content block further down, unchanged.
    #}
    {% set ornament_svg %}<svg aria-hidden="true" width="26" height="21" viewBox="90 254 822 672"><path fill="var(--accent)" fill-rule="evenodd" d="M367.2 548.3 L367.5 550.8 L445.4 681.7 L447.3 683.3 L469.9 646.9 L469.9 644.7 L413.7 549.0 L411.5 548.0Z M249.5 346.2 L248.9 347.1 L250.5 350.3 L256.4 359.7 L262.4 370.7 L287.5 412.1 L296.6 428.1 L297.6 429.1 L298.5 429.1 L302.6 423.4 L306.0 417.1 L320.8 393.9 L321.1 392.3 L294.7 347.1 L293.2 345.9Z M911.5 254.2 L646.6 254.2 L725.0 389.8 L755.5 339.9 L741.7 309.2 L811.7 310.7 L495.9 828.0 L477.1 796.9 L573.4 642.2 L466.4 460.5 L388.6 459.2 L427.8 392.0 L348.1 256.4 L90.4 255.8 L497.5 925.6Z M310.7 516.6 L431.3 516.3 L499.7 629.9 L508.5 646.3 L447.6 748.6 L440.1 738.5 L311.0 519.8Z M192.7 309.8 L308.2 309.2 L310.7 310.4 L358.8 391.7 L358.8 393.9 L318.3 460.5 L277.8 460.8 L275.9 459.2 L192.1 311.7Z M385.8 254.2 L461.1 382.6 L506.0 347.5 L486.5 309.5 L570.0 309.5 L589.1 343.7 L482.7 423.4 L593.2 609.2 L705.9 426.9 L606.1 253.9Z M617.4 392.0 L619.9 394.9 L637.8 425.6 L639.0 429.4 L599.2 497.5 L595.1 502.5 L588.8 493.1 L561.5 445.7 L556.2 435.3 L557.4 433.8 L612.1 395.2Z"/></svg>{% endset %}

    {% if page.title == trans('bav.find_id_title') %}
        <div class="wrap" style="padding:60px 0 100px;max-width:1040px">
            <nav class="breadcrumbs w-full py-5"><salla-breadcrumb></salla-breadcrumb></nav>
            <div class="sechead">
                <h1 class="disp" style="font-size:34px">{{ trans('bav.find_id_title') }}</h1>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                <p>{{ trans('bav.find_id_subtitle') }}</p>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-top:40px">
                <img src="{{ 'images/player-id-schematic.svg'|asset }}" alt="رسم توضيحي يوضح مكان معرّف اللاعب: الإعدادات، ثم إعدادات المستخدم، ثم نسخ المعرّف" style="width:100%;border-radius:22px;border:1px solid #232329">
                <div style="display:flex;flex-direction:column;gap:22px">
                    {% for step_text in [trans('bav.find_id_step1'), trans('bav.find_id_step2'), trans('bav.find_id_step3')] %}
                        <div style="display:flex;align-items:flex-start;gap:16px">
                            <span class="num" style="flex:none;width:36px;height:36px;border-radius:50%;background:var(--accent);color:#0A0A0B;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700">{{ loop.index }}</span>
                            <p style="font-size:16px;line-height:1.85;color:#C7C7CE;margin:6px 0 0">{{ step_text }}</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="bav-trust-item bav-trust--mobile" style="margin-top:40px;background:#141418;border:1px solid #232329;border-radius:20px;padding:26px">
                <div style="display:flex;align-items:center;gap:16px">
                    <span class="bav-trust-icon" style="flex:none"><i class="sicon-shield-check" style="color:var(--accent);font-size:22px"></i></span>
                    <div>
                        <div class="bav-trust-title">{{ trans('bav.find_id_safety_title') }}</div>
                        <div class="bav-trust-desc">{{ trans('bav.find_id_safety_tip') }}</div>
                    </div>
                </div>
            </div>
        </div>

    {% elseif page.title == trans('bav.find_recipient_id_title') %}
        {#
            Separate from "كيف أجد معرّفي؟" on purpose - a gift Double CP
            order needs the RECIPIENT's id, found from a different place
            (their own profile, not the buyer's settings) and in a
            different format (a long UID, not the short player ID). Per
            direct request (2026-11-12), built around two confirmations
            flagged as critical: the recipient hasn't already activated
            this same tier before, and the id entered is theirs, not the
            buyer's own.
        #}
        <div class="wrap" style="padding:60px 0 100px;max-width:1040px">
            <nav class="breadcrumbs w-full py-5"><salla-breadcrumb></salla-breadcrumb></nav>
            <div class="sechead">
                <h1 class="disp" style="font-size:34px">{{ trans('bav.find_recipient_id_title') }}</h1>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                <p>{{ trans('bav.find_recipient_id_subtitle') }}</p>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-top:40px">
                <img src="{{ 'images/recipient-id-schematic.svg'|asset }}" alt="رسم توضيحي يوضح مكان آيدي المستلم: ادخل على حسابه الشخصي، وانسخ الآيدي" style="width:100%;border-radius:22px;border:1px solid #232329">
                <div style="display:flex;flex-direction:column;gap:22px">
                    {% for step_text in [trans('bav.find_recipient_id_step1'), trans('bav.find_recipient_id_step2')] %}
                        <div style="display:flex;align-items:flex-start;gap:16px">
                            <span class="num" style="flex:none;width:36px;height:36px;border-radius:50%;background:var(--accent);color:#0A0A0B;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700">{{ loop.index }}</span>
                            <p style="font-size:16px;line-height:1.85;color:#C7C7CE;margin:6px 0 0">{{ step_text }}</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:16px;margin-top:40px">
                <div style="background:#1A1208;border:1px solid #3A2A14;border-radius:20px;padding:26px">
                    <div style="display:flex;align-items:center;gap:16px">
                        <span class="bav-trust-icon" style="flex:none"><i class="sicon-info" style="color:var(--accent);font-size:22px"></i></span>
                        <div>
                            <div class="bav-trust-title">{{ trans('bav.find_recipient_id_confirm1_title') }}</div>
                            <div class="bav-trust-desc">{{ trans('bav.find_recipient_id_confirm1_desc') }}</div>
                        </div>
                    </div>
                </div>
                <div style="background:#1A1208;border:1px solid #3A2A14;border-radius:20px;padding:26px">
                    <div style="display:flex;align-items:center;gap:16px">
                        <span class="bav-trust-icon" style="flex:none"><i class="sicon-shield-check" style="color:var(--accent);font-size:22px"></i></span>
                        <div>
                            <div class="bav-trust-title">{{ trans('bav.find_recipient_id_confirm2_title') }}</div>
                            <div class="bav-trust-desc">{{ trans('bav.find_recipient_id_confirm2_desc') }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    {% elseif page.title == trans('bav.faq_page_title') %}
        <div class="wrap" style="padding:60px 0 100px;max-width:900px">
            <nav class="breadcrumbs w-full py-5"><salla-breadcrumb></salla-breadcrumb></nav>
            <div class="sechead">
                <h1 class="disp" style="font-size:34px">{{ trans('bav.faq_page_title') }}</h1>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                <p>{{ trans('bav.faq_page_subtitle') }}</p>
            </div>
            <div class="faq" style="margin-top:30px">
                {% for i in 1..14 %}
                    <details>
                        <summary>{{ trans('bav.faq_q' ~ i) }}</summary>
                        <p>{% if i == 6 or i == 8 %}{{ trans('bav.faq_a' ~ i, {hours: theme.settings.get('working_hours_text')}) }}{% else %}{{ trans('bav.faq_a' ~ i) }}{% endif %}</p>
                    </details>
                {% endfor %}
            </div>
        </div>

    {% elseif page.title == trans('bav.about_eyebrow') %}
        <div class="wrap" style="padding:50px 0 100px;display:flex;flex-direction:column;gap:56px">
            <nav class="breadcrumbs w-full py-5"><salla-breadcrumb></salla-breadcrumb></nav>

            <div class="about-hero" data-reveal>
                <div class="bav-mark-bg">
                    <svg aria-hidden="true" width="360" height="294" viewBox="90 254 822 672"><path fill="#FFFFFF" fill-rule="evenodd" d="M367.2 548.3 L367.5 550.8 L445.4 681.7 L447.3 683.3 L469.9 646.9 L469.9 644.7 L413.7 549.0 L411.5 548.0Z M249.5 346.2 L248.9 347.1 L250.5 350.3 L256.4 359.7 L262.4 370.7 L287.5 412.1 L296.6 428.1 L297.6 429.1 L298.5 429.1 L302.6 423.4 L306.0 417.1 L320.8 393.9 L321.1 392.3 L294.7 347.1 L293.2 345.9Z M911.5 254.2 L646.6 254.2 L725.0 389.8 L755.5 339.9 L741.7 309.2 L811.7 310.7 L495.9 828.0 L477.1 796.9 L573.4 642.2 L466.4 460.5 L388.6 459.2 L427.8 392.0 L348.1 256.4 L90.4 255.8 L497.5 925.6Z M310.7 516.6 L431.3 516.3 L499.7 629.9 L508.5 646.3 L447.6 748.6 L440.1 738.5 L311.0 519.8Z M192.7 309.8 L308.2 309.2 L310.7 310.4 L358.8 391.7 L358.8 393.9 L318.3 460.5 L277.8 460.8 L275.9 459.2 L192.1 311.7Z M385.8 254.2 L461.1 382.6 L506.0 347.5 L486.5 309.5 L570.0 309.5 L589.1 343.7 L482.7 423.4 L593.2 609.2 L705.9 426.9 L606.1 253.9Z M617.4 392.0 L619.9 394.9 L637.8 425.6 L639.0 429.4 L599.2 497.5 L595.1 502.5 L588.8 493.1 L561.5 445.7 L556.2 435.3 L557.4 433.8 L612.1 395.2Z"/></svg>
                </div>
                <div style="position:relative;max-width:620px">
                    <span style="color:var(--accent);font-size:15px;font-weight:700">{{ trans('bav.about_eyebrow') }}</span>
                    <div class="orn" style="margin:10px 0 18px"><b></b>{{ ornament_svg }}<b></b></div>
                    <h1 class="disp" style="font-size:44px;line-height:1.3">{{ trans('bav.about_title_line1') }}<br><span style="color:var(--accent)">{{ trans('bav.about_title_line2') }}</span></h1>
                    <p style="font-size:20px;line-height:1.8;color:#C7C7CE;margin-top:18px">{{ trans('bav.about_lead') }}</p>
                </div>
            </div>

            <div>
                <div class="sechead"><h2>{{ trans('bav.about_commit_title') }}</h2><div class="orn"><b></b>{{ ornament_svg }}<b></b></div></div>
                <div class="about-commit-grid" style="margin-top:30px" data-reveal>
                    <div class="about-commit-card">
                        <span class="bav-trust-icon"><i class="sicon-tag" style="color:var(--accent);font-size:20px"></i></span>
                        <div class="disp" style="font-size:20px;margin-top:20px">{{ trans('bav.about_commit1_title') }}</div>
                        <p style="font-size:14.5px;line-height:1.8;color:#9B9BA5;margin-top:10px">{{ trans('bav.about_commit1_desc') }}</p>
                    </div>
                    <div class="about-commit-card">
                        <span class="bav-trust-icon"><i class="sicon-time" style="color:var(--accent);font-size:20px"></i></span>
                        <div class="disp" style="font-size:20px;margin-top:20px">{{ trans('bav.about_commit2_title') }}</div>
                        <p style="font-size:14.5px;line-height:1.8;color:#9B9BA5;margin-top:10px">{{ trans('bav.about_commit2_desc') }}</p>
                    </div>
                    <div class="about-commit-card">
                        <span class="bav-trust-icon"><i class="sicon-shield-check" style="color:var(--accent);font-size:20px"></i></span>
                        <div class="disp" style="font-size:20px;margin-top:20px">{{ trans('bav.about_commit3_title') }}</div>
                        <p style="font-size:14.5px;line-height:1.8;color:#9B9BA5;margin-top:10px">{{ trans('bav.about_commit3_desc') }}</p>
                    </div>
                    <div class="about-commit-card">
                        <span class="bav-trust-icon"><i class="sicon-headphones" style="color:var(--accent);font-size:20px"></i></span>
                        <div class="disp" style="font-size:20px;margin-top:20px">{{ trans('bav.about_commit4_title') }}</div>
                        <p style="font-size:14.5px;line-height:1.8;color:#9B9BA5;margin-top:10px">{{ trans('bav.about_commit4_desc', {hours: theme.settings.get('working_hours_text')}) }}</p>
                    </div>
                </div>
            </div>

            <div>
                <div class="sechead"><h2>{{ trans('bav.about_how_title') }}</h2><div class="orn"><b></b>{{ ornament_svg }}<b></b></div></div>
                <div class="about-timeline" style="margin-top:30px" data-reveal>
                    {% set steps = [
                        {title: trans('bav.about_how_step1'), desc: trans('bav.about_how_step1_desc')},
                        {title: trans('bav.about_how_step2'), desc: trans('bav.about_how_step2_desc')},
                        {title: trans('bav.about_how_step3'), desc: trans('bav.about_how_step3_desc')},
                        {title: trans('bav.about_how_step4'), desc: trans('bav.about_how_step4_desc')},
                    ] %}
                    {% for s in steps %}
                        <div class="step">
                            <span class="num" style="width:44px;height:44px;border-radius:50%;background:var(--accent);color:#0A0A0B;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700">{{ loop.index }}</span>
                            <div class="disp" style="font-size:16.5px;margin-top:18px">{{ s.title }}</div>
                            <p style="font-size:13.5px;line-height:1.8;color:#8E8E98;margin-top:8px">{{ s.desc }}</p>
                        </div>
                    {% endfor %}
                </div>
                <p style="font-size:14px;color:#7C7C86;margin-top:22px">{{ trans('bav.about_how_digital_note') }}</p>
            </div>

            <div class="about-doc-card" data-reveal>
                <img src="{{ 'images/freelance-badge.svg'|asset }}" alt="شعار منصة العمل الحر" width="150" height="56">
                <span style="font-size:13px;color:#6B6B76;font-weight:600">{{ trans('bav.about_doc_title') }}</span>
                <span class="num" dir="ltr">{{ theme.settings.get('freelance_doc_code') }}</span>
                <p style="font-size:14.5px;color:#4A4A52;margin-top:4px">{{ trans('bav.about_doc_line') }}</p>
            </div>

            {% set whatsapp_number_raw = theme.settings.get('whatsapp_number', '966564622432') %}
            {% set whatsapp_number = whatsapp_number_raw|replace({'+': '', ' ': ''}) %}
            {% if whatsapp_number starts with '00' %}{% set whatsapp_number = whatsapp_number|slice(2) %}{% endif %}
            <div class="about-cta-bar" data-reveal>
                <h2 class="disp" style="font-size:28px">{{ trans('bav.about_cta_title') }}</h2>
                <p style="font-size:16px;color:#9B9BA5;margin-top:10px">{{ trans('bav.about_cta_desc') }}</p>
                <div style="display:flex;justify-content:center;gap:14px;margin-top:26px;flex-wrap:wrap">
                    <a href="{{ theme.settings.get('services_category_url', store.url ~ '#services') }}" class="btn btn-p">{{ trans('bav.about_cta_primary') }}</a>
                    {% if theme.settings.get('find_id_page_url') %}
                        <a href="{{ theme.settings.get('find_id_page_url') }}" class="btn btn-g">{{ trans('bav.about_cta_secondary') }}</a>
                    {% endif %}
                </div>
                <div style="display:flex;justify-content:center;margin-top:18px">
                    <a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:10px;padding:12px 24px;border-radius:999px;background:#17171B;border:1px solid #2A2A31;color:#F4F4F2;font-weight:700;font-size:15px;transition:border-color .2s,color .2s" onmouseover="this.style.borderColor='#25D366';this.style.color='#25D366'" onmouseout="this.style.borderColor='#2A2A31';this.style.color='#F4F4F2'">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                        {{ trans('bav.about_cta_contact') }}
                    </a>
                </div>
            </div>
        </div>

    {% elseif page.title == trans('bav.refund_policy_title') %}
        {#
            Expanded to a fuller policy per صاحب المتجر's direct request
            (طلبات_صاحب_المتجر.md point 7, 2026-11-12) - supersedes the
            shorter version Salman approved earlier the same day. Covers
            pre-fulfillment cancellation, payment-gateway fee deduction on
            refunds, post-fulfillment non-refundability, store-side errors/
            mismatched service, and special cases (duplicate payment,
            unregistered order, unfulfilled service) - built only from
            policy principles already established elsewhere in the project
            (exact-id-entered execution, working hours/contact channel) plus
            general, factual refund mechanics (a refund can't be approved
            before fulfillment starts; a payment gateway's own fee on a
            refund, if any, isn't ours to absorb). No invented legal clauses
            about liability, jurisdiction, or specific regulation citations -
            those need real legal review this theme can't provide.
        #}
        <div class="wrap" style="padding:60px 0 100px;max-width:760px">
            <nav class="breadcrumbs w-full py-5"><salla-breadcrumb></salla-breadcrumb></nav>
            <div class="sechead">
                <h1 class="disp" style="font-size:32px">{{ trans('bav.refund_policy_title') }}</h1>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
            </div>
            <div style="display:flex;flex-direction:column;gap:18px;margin-top:30px">
                <div class="step" style="display:flex;align-items:flex-start;gap:16px;padding:24px">
                    <span class="ico" style="flex:none;width:44px;height:44px;border-radius:14px"><i class="sicon-page-content" style="color:var(--accent);font-size:20px"></i></span>
                    <div>
                        <div class="disp" style="font-size:16px">{{ trans('bav.refund_policy_scope_title') }}</div>
                        <p style="font-size:14px;line-height:1.8;color:#A6A6AF;margin-top:6px">{{ trans('bav.refund_policy_scope_desc') }}</p>
                    </div>
                </div>
                <div class="step" style="display:flex;align-items:flex-start;gap:16px;padding:24px">
                    <span class="ico" style="flex:none;width:44px;height:44px;border-radius:14px"><i class="sicon-wallet" style="color:var(--accent);font-size:20px"></i></span>
                    <div>
                        <div class="disp" style="font-size:16px">{{ trans('bav.refund_policy_before_title') }}</div>
                        <p style="font-size:14px;line-height:1.8;color:#A6A6AF;margin-top:6px">{{ trans('bav.refund_policy_before_desc') }}</p>
                    </div>
                </div>
                <div class="step" style="display:flex;align-items:flex-start;gap:16px;padding:24px">
                    <span class="ico" style="flex:none;width:44px;height:44px;border-radius:14px"><i class="sicon-receipt" style="color:var(--accent);font-size:20px"></i></span>
                    <div>
                        <div class="disp" style="font-size:16px">{{ trans('bav.refund_policy_fees_title') }}</div>
                        <p style="font-size:14px;line-height:1.8;color:#A6A6AF;margin-top:6px">{{ trans('bav.refund_policy_fees_desc') }}</p>
                    </div>
                </div>
                <div class="step" style="display:flex;align-items:flex-start;gap:16px;padding:24px">
                    <span class="ico" style="flex:none;width:44px;height:44px;border-radius:14px"><i class="sicon-file-off" style="color:var(--accent);font-size:20px"></i></span>
                    <div>
                        <div class="disp" style="font-size:16px">{{ trans('bav.refund_policy_digital_title') }}</div>
                        <p style="font-size:14px;line-height:1.8;color:#A6A6AF;margin-top:6px">{{ trans('bav.refund_policy_digital_desc') }}</p>
                        <p style="font-size:13px;line-height:1.8;color:#7C7C86;margin-top:8px">{{ trans('bav.refund_policy_known_note') }}</p>
