{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "cat.show"                                                      |
#}
{% extends "layouts.master" %}
{% block content %}
    {% set hero_image = theme.settings.get('hero_image') %}
    {% set ornament_svg %}<svg aria-hidden="true" width="26" height="21" viewBox="90 254 822 672"><path fill="var(--accent)" fill-rule="evenodd" d="M367.2 548.3 L367.5 550.8 L445.4 681.7 L447.3 683.3 L469.9 646.9 L469.9 644.7 L413.7 549.0 L411.5 548.0Z M249.5 346.2 L248.9 347.1 L250.5 350.3 L256.4 359.7 L262.4 370.7 L287.5 412.1 L296.6 428.1 L297.6 429.1 L298.5 429.1 L302.6 423.4 L306.0 417.1 L320.8 393.9 L321.1 392.3 L294.7 347.1 L293.2 345.9Z M911.5 254.2 L646.6 254.2 L725.0 389.8 L755.5 339.9 L741.7 309.2 L811.7 310.7 L495.9 828.0 L477.1 796.9 L573.4 642.2 L466.4 460.5 L388.6 459.2 L427.8 392.0 L348.1 256.4 L90.4 255.8 L497.5 925.6Z M310.7 516.6 L431.3 516.3 L499.7 629.9 L508.5 646.3 L447.6 748.6 L440.1 738.5 L311.0 519.8Z M192.7 309.8 L308.2 309.2 L310.7 310.4 L358.8 391.7 L358.8 393.9 L318.3 460.5 L277.8 460.8 L275.9 459.2 L192.1 311.7Z M385.8 254.2 L461.1 382.6 L506.0 347.5 L486.5 309.5 L570.0 309.5 L589.1 343.7 L482.7 423.4 L593.2 609.2 L705.9 426.9 L606.1 253.9Z M617.4 392.0 L619.9 394.9 L637.8 425.6 L639.0 429.4 L599.2 497.5 L595.1 502.5 L588.8 493.1 L561.5 445.7 L556.2 435.3 L557.4 433.8 L612.1 395.2Z"/></svg>{% endset %}

    <section class="hero-d dsk" style="position:relative;min-height:760px;border-bottom:1px solid #1D1D22;overflow:hidden;background:#07070A">
        {% if hero_image %}
            <div class="hero-bg" style="position:absolute;top:0;bottom:0;left:0;right:0;margin:0 auto;max-width:1440px;background-image:url('{{ hero_image|cdn(1600) }}');background-size:auto 100%;background-position:left center;background-repeat:no-repeat"></div>
        {% endif %}
        <div class="hero-grad" style="position:absolute;inset:0;background:linear-gradient(270deg,rgba(9,9,11,.97) 0%,rgba(9,9,11,.9) 30%,rgba(9,9,11,.35) 52%,rgba(9,9,11,0) 70%)"></div>
        <div class="hero-bot" style="position:absolute;left:0;right:0;bottom:0;height:160px;background:linear-gradient(180deg,rgba(9,9,11,0),#09090B)"></div>
        <div class="wrap hero-wrap" style="position:relative;display:flex;align-items:center;min-height:760px;padding-bottom:70px">
            <div style="max-width:560px;display:flex;flex-direction:column;align-items:flex-start;gap:30px">
                <h1 class="h1 disp" style="margin:0;font-size:80px;line-height:1.1">
                    <span style="display:block">{{ theme.settings.get('hero_title_line1') }}</span>
                    <span style="display:block;color:var(--accent)">{{ theme.settings.get('hero_title_line2') }}</span>
                </h1>
                <p style="margin:0;font-size:20px;line-height:1.85;color:#B9B9C2;max-width:500px">{{ theme.settings.get('hero_subtitle') }}</p>
                <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:6px">
                    <a href="{{ theme.settings.get('currency_category_url', '#choose-game') }}" class="btn btn-p">
                        {{ trans('bav.nav.choose_game') }}
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A0A0B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                    </a>
                    <a href="{{ theme.settings.get('offers_category_url', '#offers') }}" class="btn btn-g">{{ trans('bav.nav.offers') }}</a>
                </div>
                <div style="display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:14px;border:1px solid #2E2E35;background:rgba(255,255,255,.03);max-width:100%">
                    <svg aria-hidden="true" style="flex:none" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <span style="font-size:14px;line-height:1.7;color:#C7C7CF">{{ trans('bav.hero_execution_note', {time: theme.settings.get('execution_time_text')}) }}</span>
                </div>
            </div>
        </div>
    </section>

    {# Mobile hero (simplified, stacked) #}
    <section class="mob" style="position:relative;overflow:hidden;border-bottom:1px solid #1D1D22">
        {% if hero_image %}
            <div class="hero-bg" style="width:100%;background-image:url('{{ hero_image|cdn(900) }}')"></div>
        {% endif %}
        <div class="wrap hero-wrap" style="position:relative;padding-top:30px;padding-bottom:36px;display:flex;flex-direction:column;gap:18px">
            <h1 class="disp" style="margin:0;font-size:46px;line-height:1.15">
                <span style="display:block">{{ theme.settings.get('hero_title_line1') }}</span>
                <span style="display:block;color:var(--accent)">{{ theme.settings.get('hero_title_line2') }}</span>
            </h1>
            <p style="margin:0;font-size:16px;line-height:1.85;color:#B9B9C2">{{ theme.settings.get('hero_subtitle') }}</p>
            <div style="display:flex;flex-wrap:wrap;gap:12px">
                <a href="{{ theme.settings.get('currency_category_url', '#choose-game') }}" class="btn btn-p" style="flex:1;min-width:150px;height:54px;font-size:16px;padding:0 18px">{{ trans('bav.nav.choose_game') }}</a>
                <a href="{{ theme.settings.get('offers_category_url', '#offers') }}" class="btn btn-g" style="flex:1;min-width:150px;height:54px;font-size:16px;padding:0 18px">{{ trans('bav.nav.offers') }}</a>
            </div>
            <div style="display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:14px;border:1px solid #2E2E35;background:rgba(255,255,255,.03)">
                <svg aria-hidden="true" style="flex:none" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                <span style="font-size:14px;line-height:1.7;color:#C7C7CF">{{ trans('bav.hero_execution_note', {time: theme.settings.get('execution_time_text')}) }}</span>
            </div>
        </div>
    </section>

    {#
        Rewards ladder — reacts to live cart value. Placed before the
        Offers section (moved up from its old spot near the bottom) so
        it catches the eye early, per direct request.
    #}
    {% set reward_levels = theme.settings.get('reward_levels') %}
    <section style="padding:60px 0 40px">
        <div class="wrap">
            <div class="sechead">
                <h2>{{ trans('bav.rewards_title') }}</h2>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                <p>{{ trans('bav.rewards_subtitle') }}</p>
            </div>
            <div class="ladder" id="bav-ladder"
                 data-initial-total="{{ cart.total }}"
                 data-lang-add-more="{{ trans('bav.rewards_add_more') }}"
                 data-lang-all-unlocked="{{ trans('bav.rewards_all_unlocked') }}"
                 data-lang-cart-value="{{ trans('bav.rewards_cart_value') }}"
                 data-lang-unlocked="{{ trans('bav.reward_unlocked') }}"
                 data-lang-next="{{ trans('bav.reward_next') }}"
                 data-lang-locked="{{ trans('bav.reward_locked') }}"
                 style="padding:36px 36px 40px;border-radius:28px;border:1px solid #232329;background:linear-gradient(180deg,#101013,#0B0B0D)">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:26px">
                    <div class="lad-text" id="bav-lad-text" style="font-size:20px;font-weight:600"></div>
                    <div style="font-size:15px;color:#8E8E98">{{ trans('bav.rewards_cart_value') }} <span class="num lad-total" id="bav-lad-total" style="color:#fff">0.00</span> ر.س</div>
                </div>
                <div style="position:relative;height:10px;border-radius:999px;background:#1B1B20;margin-bottom:30px">
                    <div class="lad-fill" id="bav-lad-fill" style="position:absolute;top:0;right:0;height:100%;width:0%;border-radius:999px;background:linear-gradient(270deg,var(--accent),#FFB27A);box-shadow:0 0 24px var(--accent);transition:width .6s cubic-bezier(.2,.8,.2,1)"></div>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px">
                    {% for level in reward_levels %}
                        <div class="lv" data-n="{{ loop.index }}" data-amt="{{ level['reward_levels.amount'] }}" style="position:relative;padding:26px 24px;border-radius:20px;border:1px solid #232329;background:#0F0F12">
                            <div style="display:flex;align-items:center;justify-content:space-between">
                                <span class="num" style="font-size:13px;letter-spacing:.16em;color:#8E8E98">LEVEL 0{{ loop.index }}</span>
                                <span class="lv-chip" style="font-size:12px;font-weight:700;padding:5px 12px;border-radius:999px;background:#131316;border:1px solid #2A2A31;color:#6E6E78">{{ trans('bav.reward_locked') }}</span>
                            </div>
                            <div class="num" style="font-size:34px;margin-top:20px">{{ level['reward_levels.amount'] }}<span class="cur" style="font-family:var(--font-main);margin-right:6px">ر.س</span></div>
                            <div style="font-size:16px;line-height:1.7;color:#B4B4BC;margin-top:10px">{{ level['reward_levels.text'] }}</div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    {#
        Offers — any product currently on sale, pulled automatically by
        Salla itself (source="offers" is a real, built-in Twilight source
        type for this exact purpose) instead of a merchant having to
        hand-pick products here every time a sale starts or ends.
        Twig can no longer know in advance whether there are zero or a
        hundred such products (that's resolved client-side by the real
        component at runtime, same as Theme Raed's own offers slider
        component does) so this section always renders rather than being
        gated on a selection count like the other homepage sections.
    #}
    <section id="offers" style="padding:60px 0 40px">
        <div class="wrap">
            <div class="sechead">
                <h2>{{ trans('bav.nav.offers') }}</h2>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                <p>{{ trans('bav.offers_subtitle') }}</p>
            </div>
            <div class="g3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
                <salla-products-list
                    source="offers"
                    limit="4"
                    product-card-component="custom-salla-product-card">
                </salla-products-list>
            </div>
            {% if theme.settings.get('offers_category_url') %}
                <div style="text-align:center;margin-top:30px">
                    <a href="{{ theme.settings.get('offers_category_url') }}" class="btn btn-g">{{ trans('bav.see_more') }}</a>
                </div>
            {% endif %}
        </div>
    </section>

    {# Choose your currency — merchant-selected products (no game names shown) #}
    {% set game_products = [] %}
    {% for item in theme.settings.get('game_products')|default([]) %}{% set game_products = game_products|merge([item.value]) %}{% endfor %}
    {% if game_products|length %}
        <section id="choose-game" style="padding:110px 0 40px">
            <div class="wrap">
                <div class="sechead">
                    <h2>{{ trans('bav.nav.choose_game') }}</h2>
                    <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                    <p>فئات عملات متنوعة تناسب احتياجك، ونضيف المزيد تباعًا.</p>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px">
                    <salla-products-list
                        source="selected"
                        source-value="{{ game_products|json_encode }}"
                        product-card-component="custom-salla-product-card">
                    </salla-products-list>
                </div>
                {% if theme.settings.get('currency_category_url') and game_products|length > 3 %}
                    <div style="text-align:center;margin-top:30px">
                        <a href="{{ theme.settings.get('currency_category_url') }}" class="btn btn-g">{{ trans('bav.see_more') }}</a>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {# Double CP — merchant-selected products #}
    {% set double_cp_products = [] %}
    {% for item in theme.settings.get('double_cp_products')|default([]) %}{% set double_cp_products = double_cp_products|merge([item.value]) %}{% endfor %}
    {% if double_cp_products|length %}
        <section id="double-cp" style="padding:40px 0 40px">
            <div class="wrap">
                <div class="sechead">
                    <h2>{{ trans('bav.nav.double_cp') }}</h2>
                    <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                    <p>{{ trans('bav.double_cp_subtitle') }}</p>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
                    <salla-products-list
                        source="selected"
                        source-value="{{ double_cp_products|json_encode }}"
                        product-card-component="custom-salla-product-card">
                    </salla-products-list>
                </div>
                {% if theme.settings.get('double_cp_category_url') and double_cp_products|length > 3 %}
                    <div style="text-align:center;margin-top:30px">
                        <a href="{{ theme.settings.get('double_cp_category_url') }}" class="btn btn-g">{{ trans('bav.see_more') }}</a>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {# Gift Double CP — separate, same tiers, "ID" field instead of Player ID #}
    {% set double_cp_gift_products = [] %}
    {% for item in theme.settings.get('double_cp_gift_products')|default([]) %}{% set double_cp_gift_products = double_cp_gift_products|merge([item.value]) %}{% endfor %}
    {% if double_cp_gift_products|length %}
        <section id="double-cp-gift" style="padding:40px 0 40px;background:#0D0D10">
            <div class="wrap">
                <div class="sechead">
                    <h2>{{ trans('bav.nav.double_cp_gift') }}</h2>
                    <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                    <p>{{ trans('bav.double_cp_gift_subtitle') }}</p>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
                    <salla-products-list
                        source="selected"
                        source-value="{{ double_cp_gift_products|json_encode }}"
                        product-card-component="custom-salla-product-card">
                    </salla-products-list>
                </div>
                {% if theme.settings.get('double_cp_gift_category_url') and double_cp_gift_products|length > 3 %}
                    <div style="text-align:center;margin-top:30px">
                        <a href="{{ theme.settings.get('double_cp_gift_category_url') }}" class="btn btn-g">{{ trans('bav.see_more') }}</a>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {# Digital files — merchant-selected #}
    {% set digital_files = [] %}
    {% for item in theme.settings.get('digital_files_products')|default([]) %}{% set digital_files = digital_files|merge([item.value]) %}{% endfor %}
    {% if digital_files|length %}
        <section id="digital-files" style="padding:40px 0 40px">
            <div class="wrap">
                <div class="sechead">
                    <h2>{{ trans('bav.nav.digital_files') }}</h2>
                    <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                    <p>{{ trans('bav.digital_files_subtitle') }}</p>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
                    <salla-products-list
                        source="selected"
                        source-value="{{ digital_files|json_encode }}"
                        product-card-component="custom-salla-product-card">
                    </salla-products-list>
                </div>
                {% if theme.settings.get('digital_files_category_url') and digital_files|length > 3 %}
                    <div style="text-align:center;margin-top:30px">
                        <a href="{{ theme.settings.get('digital_files_category_url') }}" class="btn btn-g">{{ trans('bav.see_more') }}</a>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {# Services — merchant-selected #}
    {% set services_products = [] %}
    {% for item in theme.settings.get('services_products')|default([]) %}{% set services_products = services_products|merge([item.value]) %}{% endfor %}
    {% if services_products|length %}
        <section id="services" style="padding:40px 0 40px;background:#0D0D10">
            <div class="wrap">
                <div class="sechead">
                    <h2>{{ trans('bav.nav.services') }}</h2>
                    <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                    <p>{{ trans('bav.services_subtitle') }}</p>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
                    <salla-products-list
                        source="selected"
                        source-value="{{ services_products|json_encode }}"
                        product-card-component="custom-salla-product-card">
                    </salla-products-list>
                </div>
                {% if theme.settings.get('services_category_url') and services_products|length > 3 %}
                    <div style="text-align:center;margin-top:30px">
                        <a href="{{ theme.settings.get('services_category_url') }}" class="btn btn-g">{{ trans('bav.see_more') }}</a>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {#
        Weapon charging — merchant-selected. The available weapons change
        from time to time (طلبات_صاحب_المتجر.md), so this reads whatever
        the merchant currently has selected in theme settings exactly like
        the other homepage sections, instead of a fixed hardcoded list.
    #}
    {% set weapons_products = [] %}
    {% for item in theme.settings.get('weapons_products')|default([]) %}{% set weapons_products = weapons_products|merge([item.value]) %}{% endfor %}
    {% if weapons_products|length %}
        <section id="weapons" style="padding:40px 0 40px">
            <div class="wrap">
                <div class="sechead">
                    <h2>{{ trans('bav.nav.weapons') }}</h2>
                    <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
                    <salla-products-list
                        source="selected"
                        source-value="{{ weapons_products|json_encode }}"
                        product-card-component="custom-salla-product-card">
                    </salla-products-list>
                </div>
                {% if theme.settings.get('weapons_category_url') and weapons_products|length > 3 %}
                    <div style="text-align:center;margin-top:30px">
                        <a href="{{ theme.settings.get('weapons_category_url') }}" class="btn btn-g">{{ trans('bav.see_more') }}</a>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {# How to top up — 3 steps #}
    <section id="how" style="padding:100px 0 40px;background:#0D0D10">
        <div class="wrap">
            <div class="sechead">
                <h2>{{ trans('bav.how_title') }}</h2>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                <p>{{ trans('bav.how_subtitle') }}</p>
            </div>
            <div class="g-steps g3" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px">
                <div class="step">
                    <div style="display:flex;align-items:center;justify-content:space-between">
                        <span class="ico" style="width:56px;height:56px;border-radius:16px"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5L12 12l8-4.5M12 12v9"/></svg></span>
                        <span class="num" style="font-size:64px;line-height:1;color:transparent;-webkit-text-stroke:1.5px #34343B">01</span>
                    </div>
                    <div class="disp" style="font-size:26px;margin-top:26px">{{ trans('bav.how_step1_title') }}</div>
                    <div style="font-size:16px;line-height:1.85;color:#9B9BA5;margin-top:10px">{{ trans('bav.how_step1_desc') }}</div>
                </div>
                <div class="step">
                    <div style="display:flex;align-items:center;justify-content:space-between">
                        <span class="ico" style="width:56px;height:56px;border-radius:16px"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><circle cx="9" cy="11" r="2"/><path d="M6.5 16c.6-1.4 1.6-2 2.5-2s1.9.6 2.5 2M14 10h4M14 14h3"/></svg></span>
                        <span class="num" style="font-size:64px;line-height:1;color:transparent;-webkit-text-stroke:1.5px #34343B">02</span>
                    </div>
                    <div class="disp" style="font-size:26px;margin-top:26px">{{ trans('bav.how_step2_title') }}</div>
                    <div style="font-size:16px;line-height:1.85;color:#9B9BA5;margin-top:10px">{{ trans('bav.how_step2_desc') }}</div>
                </div>
                <div class="step">
                    <div style="display:flex;align-items:center;justify-content:space-between">
                        <span class="ico" style="width:56px;height:56px;border-radius:16px"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                        <span class="num" style="font-size:64px;line-height:1;color:transparent;-webkit-text-stroke:1.5px #34343B">03</span>
                    </div>
                    <div class="disp" style="font-size:26px;margin-top:26px">{{ trans('bav.how_step3_title') }}</div>
                    <div style="font-size:16px;line-height:1.85;color:#9B9BA5;margin-top:10px">{{ trans('bav.how_step3_desc', {time: theme.settings.get('execution_time_text'), hours: theme.settings.get('working_hours_text')}) }}</div>
                </div>
            </div>
        </div>
    </section>

    {# FAQ (short preview) #}
    <section id="faq" style="padding:40px 0 110px">
        <div class="wrap" style="max-width:980px">
            <div class="sechead">
                <h2>{{ trans('bav.nav.faq') }}</h2>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
            </div>
            <div class="faq">
                <details>
                    <summary>{{ trans('bav.faq_q1') }}</summary>
