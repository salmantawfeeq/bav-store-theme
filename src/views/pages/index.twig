{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "cat.show"                                                      |
#}
{% extends "layouts.master" %}
{% block content %}
    {% set hero_image = theme.settings.get('hero_image') %}
    {% set ornament_svg %}<svg aria-hidden="true" width="26" height="21" viewBox="90 254 822 672"><path fill="var(--accent)" fill-rule="evenodd" d="M367.2 548.3 L367.5 550.8 L445.4 681.7 L447.3 683.3 L469.9 646.9 L469.9 644.7 L413.7 549.0 L411.5 548.0Z M249.5 346.2 L248.9 347.1 L250.5 350.3 L256.4 359.7 L262.4 370.7 L287.5 412.1 L296.6 428.1 L297.6 429.1 L298.5 429.1 L302.6 423.4 L306.0 417.1 L320.8 393.9 L321.1 392.3 L294.7 347.1 L293.2 345.9Z M911.5 254.2 L646.6 254.2 L725.0 389.8 L755.5 339.9 L741.7 309.2 L811.7 310.7 L495.9 828.0 L477.1 796.9 L573.4 642.2 L466.4 460.5 L388.6 459.2 L427.8 392.0 L348.1 256.4 L90.4 255.8 L497.5 925.6Z M310.7 516.6 L431.3 516.3 L499.7 629.9 L508.5 646.3 L447.6 748.6 L440.1 738.5 L311.0 519.8Z M192.7 309.8 L308.2 309.2 L310.7 310.4 L358.8 391.7 L358.8 393.9 L318.3 460.5 L277.8 460.8 L275.9 459.2 L192.1 311.7Z M385.8 254.2 L461.1 382.6 L506.0 347.5 L486.5 309.5 L570.0 309.5 L589.1 343.7 L482.7 423.4 L593.2 609.2 L705.9 426.9 L606.1 253.9Z M617.4 392.0 L619.9 394.9 L637.8 425.6 L639.0 429.4 L599.2 497.5 L595.1 502.5 L588.8 493.1 L561.5 445.7 L556.2 435.3 L557.4 433.8 L612.1 395.2Z"/></svg>{% endset %}

    <section class="hero-d dsk" style="position:relative;min-height:760px;border-bottom:1px solid #1D1D22;overflow:hidden;background:#07070A">
        {% if hero_image %}
            <div class="hero-bg" style="position:absolute;top:0;bottom:0;left:0;right:0;margin:0 auto;max-width:1440px;background-image:url('{{ hero_image|cdn(1600) }}');background-size:auto 100%;background-position:left center;background-repeat:no-repeat"></div>
        {% endif %}
        <div class="hero-grad" style="position:absolute;inset:0;background:linear-gradient(270deg,rgba(9,9,11,.97) 0%,rgba(9,9,11,.9) 30%,rgba(9,9,11,.35) 52%,rgba(9,9,11,0) 70%)"></div>
        <div class="hero-bot" style="position:absolute;left:0;right:0;bottom:0;height:160px;background:linear-gradient(180deg,rgba(9,9,11,0),#09090B)"></div>
        <div class="wrap hero-wrap" style="position:relative;display:flex;align-items:center;min-height:760px;padding-bottom:70px">
            <div style="max-width:560px;display:flex;flex-direction:column;align-items:flex-start;gap:30px">
                <span style="display:inline-flex;align-items:center;gap:12px;border:1px solid #34343B;border-radius:999px;padding:9px 18px 9px 20px;font-size:15px;color:#D2D2D8;background:rgba(15,15,18,.7);backdrop-filter:blur(8px)">
                    <span style="width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent)"></span>
                    {{ trans('bav.nav.choose_game') }}
                </span>
                <h1 class="h1 disp" style="margin:0;font-size:80px;line-height:1.1">
                    <span style="display:block">{{ theme.settings.get('hero_title_line1') }}</span>
                    <span style="display:block;color:var(--accent)">{{ theme.settings.get('hero_title_line2') }}</span>
                </h1>
                <p style="margin:0;font-size:21px;line-height:1.85;color:#B9B9C2;max-width:500px">{{ theme.settings.get('hero_subtitle') }}</p>
                <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:6px">
                    <a href="#choose-game" class="btn btn-p">
                        {{ trans('bav.nav.choose_game') }}
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A0A0B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                    </a>
                    <a href="#other-services" class="btn btn-g">{{ trans('bav.nav.other_services') }}</a>
                </div>
                <div style="display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:14px;border:1px solid #2E2E35;background:rgba(255,255,255,.03);max-width:100%">
                    <svg aria-hidden="true" style="flex:none" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <span style="font-size:14px;line-height:1.7;color:#C7C7CF">{{ theme.settings.get('execution_time_text') }}</span>
                </div>
            </div>
        </div>
    </section>

    {# Mobile hero (simplified, stacked) #}
    <section class="mob" style="position:relative;overflow:hidden;border-bottom:1px solid #1D1D22">
        <div class="wrap" style="position:relative;padding-top:30px;padding-bottom:36px;display:flex;flex-direction:column;gap:18px">
            <span style="align-self:flex-start;display:inline-flex;align-items:center;gap:10px;border:1px solid #34343B;border-radius:999px;padding:7px 14px;font-size:13px;color:#D2D2D8;background:rgba(15,15,18,.8)">
                <span style="width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent)"></span>
                {{ trans('bav.nav.choose_game') }}
            </span>
            <h1 class="disp" style="margin:0;font-size:46px;line-height:1.15">
                <span style="display:block">{{ theme.settings.get('hero_title_line1') }}</span>
                <span style="display:block;color:var(--accent)">{{ theme.settings.get('hero_title_line2') }}</span>
            </h1>
            <p style="margin:0;font-size:16px;line-height:1.85;color:#B9B9C2">{{ theme.settings.get('hero_subtitle') }}</p>
            <a href="#choose-game" class="btn btn-p" style="height:54px;font-size:17px;width:100%">{{ trans('bav.nav.choose_game') }}</a>
            <a href="#other-services" class="btn btn-g" style="height:54px;font-size:17px;width:100%">{{ trans('bav.nav.other_services') }}</a>
            <div style="display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:14px;border:1px solid #2E2E35;background:rgba(255,255,255,.03)">
                <svg aria-hidden="true" style="flex:none" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                <span style="font-size:14px;line-height:1.7;color:#C7C7CF">{{ theme.settings.get('execution_time_text') }}</span>
            </div>
        </div>
    </section>

    {# Trust row #}
    <div class="wrap dsk" style="margin-top:-62px;position:relative;z-index:2">
        <div class="trust">
            <div>
                <span class="ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M16 7l3 3"/></svg></span>
                <div><div style="font-weight:700;font-size:17px">معرّف اللاعب يكفي!</div><div style="font-size:14px;color:#8E8E98;margin-top:4px">راجع معرّفك بشكل صحيح قبل الدفع</div></div>
            </div>
            <div>
                <span class="ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
                <div><div style="font-weight:700;font-size:17px">حسابك في أمان</div><div style="font-size:14px;color:#8E8E98;margin-top:4px">لا نطلب كلمة سر، ومعرّف اللاعب لا يتيح الدخول لحسابك</div></div>
            </div>
            <div>
                <span class="ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><circle cx="9" cy="11" r="2"/><path d="M6.5 16c.6-1.4 1.6-2 2.5-2s1.9.6 2.5 2M14 10h4M14 14h3"/></svg></span>
                <div><div style="font-weight:700;font-size:17px">دفع آمن</div><div style="font-size:14px;color:#8E8E98;margin-top:4px">طرق دفع متنوعة وآمنة</div></div>
            </div>
            <div>
                <span class="ico"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/></svg></span>
                <div><div style="font-weight:700;font-size:17px">دعم بعد الشراء</div><div style="font-size:14px;color:#8E8E98;margin-top:4px">{{ theme.settings.get('working_hours_text') }}</div></div>
            </div>
        </div>
    </div>

    <div class="wrap mob" style="padding-top:30px">
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px">
            <div style="padding:16px;border-radius:16px;border:1px solid #232329;background:#0F0F12"><div style="font-weight:700;font-size:15px">معرّف اللاعب يكفي!</div><div style="font-size:12px;color:#8E8E98;margin-top:4px">راجعه قبل الدفع</div></div>
            <div style="padding:16px;border-radius:16px;border:1px solid #232329;background:#0F0F12"><div style="font-weight:700;font-size:15px">حسابك في أمان</div><div style="font-size:12px;color:#8E8E98;margin-top:4px">بدون كلمة سر</div></div>
            <div style="padding:16px;border-radius:16px;border:1px solid #232329;background:#0F0F12"><div style="font-weight:700;font-size:15px">دفع آمن</div><div style="font-size:12px;color:#8E8E98;margin-top:4px">طرق متعددة</div></div>
            <div style="padding:16px;border-radius:16px;border:1px solid #232329;background:#0F0F12"><div style="font-weight:700;font-size:15px">دعم بعد الشراء</div><div style="font-size:12px;color:#8E8E98;margin-top:4px">{{ theme.settings.get('working_hours_text') }}</div></div>
        </div>
    </div>

    {# Choose your game — category cards, merchant-managed #}
    {% set games = theme.settings.get('featured_games') %}
    {% if games|length %}
        <section id="choose-game" style="padding:110px 0 40px">
            <div class="wrap">
                <div class="sechead">
                    <h2>اختر لعبتك</h2>
                    <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                    <p>نبدأ بـ Call of Duty: Mobile، ونضيف ألعابًا جديدة تباعًا.</p>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px">
                    {% for game in games %}
                        <a href="{{ game['featured_games.url']|default('#') }}" class="pcard">
                            <div class="pimg"><img src="{{ (game['featured_games.image']|default('images/placeholder.png'))|cdn(600) }}" alt="{{ game['featured_games.name'] }}" loading="lazy"></div>
                            <div class="pbody">
                                <div class="pname" style="font-size:24px">{{ game['featured_games.name'] }}</div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# Game products (shipped CP, Battle Pass, etc.) — merchant-selected #}
    {% set game_products = (theme.settings.get('game_products')|default([]))|map(item => item.value) %}
    {% if game_products|length %}
        <section style="padding:40px 0 40px">
            <div class="wrap">
                <div class="g3" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px">
                    <salla-products-list
                        source="selected"
                        source-value="{{ game_products|json_encode }}"
                        product-card-component="custom-salla-product-card">
                    </salla-products-list>
                </div>
            </div>
        </section>
    {% endif %}

    {# Other services — digital files & extra services, merchant-selected #}
    {% set other_services = (theme.settings.get('other_services_products')|default([]))|map(item => item.value) %}
    {% if other_services|length %}
        <section id="other-services" style="padding:40px 0 40px">
            <div class="wrap">
                <div class="sechead">
                    <h2>{{ trans('bav.nav.other_services') }}</h2>
                    <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
                </div>
                <div class="g3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
                    <salla-products-list
                        source="selected"
                        source-value="{{ other_services|json_encode }}"
                        product-card-component="custom-salla-product-card">
                    </salla-products-list>
                </div>
            </div>
        </section>
    {% endif %}

    {# FAQ (short preview) #}
    <section id="faq" style="padding:40px 0 110px">
        <div class="wrap" style="max-width:980px">
            <div class="sechead">
                <h2>{{ trans('bav.nav.faq') }}</h2>
                <div class="orn"><b></b>{{ ornament_svg }}<b></b></div>
            </div>
            <div class="faq">
                <details>
                    <summary>أين أجد معرّف اللاعب؟</summary>
                    <p>افتح اللعبة ثم الإعدادات، ثم إعدادات المستخدم من القائمة على اليسار، وفي الأسفل ستجد معرّف اللاعب. اضغط على أيقونة النسخ للتأكد من أن المعرّف مسجّل بالشكل الصحيح وبدون أخطاء.</p>
                </details>
                <details>
                    <summary>هل تحتاجون كلمة سر حسابي؟</summary>
                    <p>لا. الشحن يتم بمعرّف اللاعب فقط، ولن نطلب منك كلمة سر أو بيانات تسجيل الدخول.</p>
                </details>
                <details>
                    <summary>متى يصل الشحن؟</summary>
                    <p>{{ theme.settings.get('execution_time_text') }}، وتصلك رسالة تأكيد فور اكتمال الشحن.</p>
                </details>
                <details>
                    <summary>هل يمكن استرجاع الملفات الرقمية؟</summary>
                    <p>لا. الملفات الرقمية غير قابلة للاسترجاع.</p>
                </details>
            </div>
        </div>
    </section>
{% endblock %}
{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}
