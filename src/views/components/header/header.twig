{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set topbar_items = theme.settings.get('topbar_items') %}
{#
    The announcement marquee and the header stick together as one unit on
    every page and every screen size (not desktop-only, and not just the
    header on its own) - .bav-sticky-top is the single element that's
    actually position:sticky; the marquee and header inside it are just
    normal flow, so they always move and stay together.
#}
<div class="bav-sticky-top">
  <div class="mq" aria-label="{{ trans('bav.nav.home') }}">
    <div class="mq-track">
      {% for i in 1..2 %}
        {% for item in topbar_items %}
          <span><i aria-hidden="true"></i>{{ item['topbar_items.text'] }}</span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <header data-testid="store-header">
  <div class="wrap bav-header-inner">
    <a href="{{ store.url }}" class="bav-brand" aria-label="{{ store.name }}">
      <svg aria-hidden="true" width="54" height="44" viewBox="90 254 822 672"><path fill="#FFFFFF" fill-rule="evenodd" d="M367.2 548.3 L367.5 550.8 L445.4 681.7 L447.3 683.3 L469.9 646.9 L469.9 644.7 L413.7 549.0 L411.5 548.0Z M249.5 346.2 L248.9 347.1 L250.5 350.3 L256.4 359.7 L262.4 370.7 L287.5 412.1 L296.6 428.1 L297.6 429.1 L298.5 429.1 L302.6 423.4 L306.0 417.1 L320.8 393.9 L321.1 392.3 L294.7 347.1 L293.2 345.9Z M911.5 254.2 L646.6 254.2 L725.0 389.8 L755.5 339.9 L741.7 309.2 L811.7 310.7 L495.9 828.0 L477.1 796.9 L573.4 642.2 L466.4 460.5 L388.6 459.2 L427.8 392.0 L348.1 256.4 L90.4 255.8 L497.5 925.6Z M310.7 516.6 L431.3 516.3 L499.7 629.9 L508.5 646.3 L447.6 748.6 L440.1 738.5 L311.0 519.8Z M192.7 309.8 L308.2 309.2 L310.7 310.4 L358.8 391.7 L358.8 393.9 L318.3 460.5 L277.8 460.8 L275.9 459.2 L192.1 311.7Z M385.8 254.2 L461.1 382.6 L506.0 347.5 L486.5 309.5 L570.0 309.5 L589.1 343.7 L482.7 423.4 L593.2 609.2 L705.9 426.9 L606.1 253.9Z M617.4 392.0 L619.9 394.9 L637.8 425.6 L639.0 429.4 L599.2 497.5 L595.1 502.5 L588.8 493.1 L561.5 445.7 L556.2 435.3 L557.4 433.8 L612.1 395.2Z"/></svg>
      <span class="num bav-brand__store">{{ trans('bav.brand_store_label') }}</span>
      {% if is_page('index') %}
        <h1 class="sr">{{ store.name }}</h1>
      {% else %}
        <h2 class="sr">{{ store.name }}</h2>
      {% endif %}
    </a>

    {#
        The site now has too many sections/pages (currency, double CP, gift
        double CP, services, digital files, weapons, offers, about, find-id,
        FAQ...) to fit as a single-row horizontal nav even on a wide desktop
        screen - the drawer (already built for mobile, listing every page
        vertically) is the only nav now, on every screen size, not just
        mobile. The old horizontal <nav class="bav-nav dsk"> list is gone.
    #}
    <div style="flex:1"></div>

    {#
        Icon-first on every screen size (not a permanently-visible input box
        that used to only hide on desktop, but still showed - full width -
        at the bottom of the mobile layout once the horizontal nav row that
        used to contain it was removed). Clicking the icon reveals a search
        bar under the header instead.
    #}
    <button type="button" class="bav-icon-btn bav-search-toggle" id="bav-search-toggle" aria-label="بحث" aria-expanded="false">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4F4F2" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    </button>

    {#
        Plain 3-bar icon (not an SVG path) so it can morph into an X via CSS
        alone when the drawer opens (body.menu-opened, already toggled by
        app.js's existing open/close handlers below) - no extra JS needed.
    #}
    <a data-testid="store-header-mobile-toggle" class="bav-icon-btn bav-burger" href="#mobile-menu" aria-label="فتح القائمة">
      <span class="bav-burger__bar"></span>
      <span class="bav-burger__bar"></span>
      <span class="bav-burger__bar"></span>
    </a>

    <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger class="bav-icon-btn"></salla-user-menu>

    <salla-cart-summary data-testid="store-header-cart" class="bav-icon-btn">
      <svg slot="icon" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F4F4F2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11h10.2L20 8H6.2"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg>
    </salla-cart-summary>
  </div>
  </header>
  <div class="bav-search-bar" id="bav-search-bar">
    <div class="wrap" style="display:flex;align-items:center;gap:12px">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9B9BA5" stroke-width="2" stroke-linecap="round" style="flex:none"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <salla-search data-testid="store-header-search" inline></salla-search>
      <button type="button" class="bav-search-close" id="bav-search-close" aria-label="إغلاق البحث">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9B9BA5" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</div>

{#
    mmenu-light (app.js's initiateMobileMenu) was already fully wired up to
    look for #mobile-menu and turn it into the off-canvas drawer, but the
    actual <nav id="mobile-menu"> markup it needs was never written - so the
    hamburger button linked to it but had nothing to open. Structure here
    (nav > ul > li > a) is mmenu-light's own documented minimum markup.
#}
<nav id="mobile-menu" class="bav-mobile-nav">
    <a href="#" class="close-mobile-menu bav-mobile-nav__close" aria-label="إغلاق القائمة">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </a>
    <ul>
        <li><a href="{{ store.url }}">{{ trans('bav.nav.home') }}</a></li>
        <li><a href="{{ theme.settings.get('offers_category_url', store.url ~ '#offers') }}">{{ trans('bav.nav.offers') }}</a></li>
        <li><a href="{{ theme.settings.get('currency_category_url', store.url ~ '#choose-game') }}">{{ trans('bav.nav.choose_game') }}</a></li>
        <li><a href="{{ theme.settings.get('double_cp_category_url', store.url ~ '#double-cp') }}">{{ trans('bav.nav.double_cp') }}</a></li>
        <li><a href="{{ theme.settings.get('double_cp_gift_category_url', store.url ~ '#double-cp-gift') }}">{{ trans('bav.nav.double_cp_gift') }}</a></li>
        <li><a href="{{ theme.settings.get('services_category_url', store.url ~ '#services') }}">{{ trans('bav.nav.services') }}</a></li>
        <li><a href="{{ theme.settings.get('digital_files_category_url', store.url ~ '#digital-files') }}">{{ trans('bav.nav.digital_files') }}</a></li>
        {#
            "حاسبة شحن الأسلحة" nested under the weapons category link for the
            same reason as the FAQ sub-items below - it's a tool that belongs
            to this category, not a standalone top-level destination.
        #}
        <li>
            <a href="{{ theme.settings.get('weapons_category_url', store.url ~ '#weapons') }}">{{ trans('bav.nav.weapons') }}</a>
            <ul class="bav-mobile-nav__sub">
                <li><a href="{{ theme.settings.get('weapons_calculator_page_url', store.url ~ '#weapons') }}">{{ trans('bav.weapons_calculator_title') }}</a></li>
            </ul>
        </li>
        {#
            "من نحن" and "كيف أجد معرّفي؟" moved from their own top-level
            entries to sit under "الأسئلة الشائعة" itself (merchant request,
            طلبات_صاحب_المتجر.md point 12) - both pages are really extensions
            of the FAQ (who we are, how to do X), not separate destinations
            that deserve equal top-level billing.
        #}
        <li>
            <a href="{{ theme.settings.get('faq_page_url', store.url ~ '#faq') }}">{{ trans('bav.nav.faq') }}</a>
            <ul class="bav-mobile-nav__sub">
                {% if theme.settings.get('about_page_url') %}
                    <li><a href="{{ theme.settings.get('about_page_url') }}">{{ trans('bav.about_eyebrow') }}</a></li>
                {% endif %}
                <li><a href="{{ theme.settings.get('find_id_page_url', store.url ~ '#how') }}">{{ trans('bav.nav.how_to_find_id') }}</a></li>
            </ul>
        </li>
        <li><salla-menu data-testid="store-mobile-menu" source="header"></salla-menu></li>
    </ul>
</nav>
