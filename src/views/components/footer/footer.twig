{% set whatsapp_number_raw = theme.settings.get('whatsapp_number', '966564622432') %}
{% set whatsapp_number = whatsapp_number_raw|replace({'+': '', ' ': ''}) %}
{% if whatsapp_number starts with '00' %}
    {% set whatsapp_number = whatsapp_number|slice(2) %}
{% endif %}
{% set whatsapp_msg = theme.settings.get('whatsapp_message') %}

<footer data-testid="store-footer" style="border-top:1px solid #1D1D22;background:#070708;position:relative;overflow:hidden">
    <div style="position:absolute;left:-140px;bottom:-150px;opacity:.03">
        <svg aria-hidden="true" width="560" height="458" viewBox="90 254 822 672"><path fill="#FFFFFF" fill-rule="evenodd" d="M367.2 548.3 L367.5 550.8 L445.4 681.7 L447.3 683.3 L469.9 646.9 L469.9 644.7 L413.7 549.0 L411.5 548.0Z M249.5 346.2 L248.9 347.1 L250.5 350.3 L256.4 359.7 L262.4 370.7 L287.5 412.1 L296.6 428.1 L297.6 429.1 L298.5 429.1 L302.6 423.4 L306.0 417.1 L320.8 393.9 L321.1 392.3 L294.7 347.1 L293.2 345.9Z M911.5 254.2 L646.6 254.2 L725.0 389.8 L755.5 339.9 L741.7 309.2 L811.7 310.7 L495.9 828.0 L477.1 796.9 L573.4 642.2 L466.4 460.5 L388.6 459.2 L427.8 392.0 L348.1 256.4 L90.4 255.8 L497.5 925.6Z M310.7 516.6 L431.3 516.3 L499.7 629.9 L508.5 646.3 L447.6 748.6 L440.1 738.5 L311.0 519.8Z M192.7 309.8 L308.2 309.2 L310.7 310.4 L358.8 391.7 L358.8 393.9 L318.3 460.5 L277.8 460.8 L275.9 459.2 L192.1 311.7Z M385.8 254.2 L461.1 382.6 L506.0 347.5 L486.5 309.5 L570.0 309.5 L589.1 343.7 L482.7 423.4 L593.2 609.2 L705.9 426.9 L606.1 253.9Z M617.4 392.0 L619.9 394.9 L637.8 425.6 L639.0 429.4 L599.2 497.5 L595.1 502.5 L588.8 493.1 L561.5 445.7 L556.2 435.3 L557.4 433.8 L612.1 395.2Z"/></svg>
    </div>

    <div class="wrap" style="position:relative;padding-top:72px;padding-bottom:40px">
        <div class="split" style="display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:48px">
            <div>
                <a href="{{ store.url }}" style="display:flex;align-items:center;gap:14px">
                    <svg aria-hidden="true" width="64" height="52" viewBox="90 254 822 672"><path fill="#FFFFFF" fill-rule="evenodd" d="M367.2 548.3 L367.5 550.8 L445.4 681.7 L447.3 683.3 L469.9 646.9 L469.9 644.7 L413.7 549.0 L411.5 548.0Z M249.5 346.2 L248.9 347.1 L250.5 350.3 L256.4 359.7 L262.4 370.7 L287.5 412.1 L296.6 428.1 L297.6 429.1 L298.5 429.1 L302.6 423.4 L306.0 417.1 L320.8 393.9 L321.1 392.3 L294.7 347.1 L293.2 345.9Z M911.5 254.2 L646.6 254.2 L725.0 389.8 L755.5 339.9 L741.7 309.2 L811.7 310.7 L495.9 828.0 L477.1 796.9 L573.4 642.2 L466.4 460.5 L388.6 459.2 L427.8 392.0 L348.1 256.4 L90.4 255.8 L497.5 925.6Z M310.7 516.6 L431.3 516.3 L499.7 629.9 L508.5 646.3 L447.6 748.6 L440.1 738.5 L311.0 519.8Z M192.7 309.8 L308.2 309.2 L310.7 310.4 L358.8 391.7 L358.8 393.9 L318.3 460.5 L277.8 460.8 L275.9 459.2 L192.1 311.7Z M385.8 254.2 L461.1 382.6 L506.0 347.5 L486.5 309.5 L570.0 309.5 L589.1 343.7 L482.7 423.4 L593.2 609.2 L705.9 426.9 L606.1 253.9Z M617.4 392.0 L619.9 394.9 L637.8 425.6 L639.0 429.4 L599.2 497.5 L595.1 502.5 L588.8 493.1 L561.5 445.7 L556.2 435.3 L557.4 433.8 L612.1 395.2Z"/></svg>
                    <span class="num" style="font-size:13px;letter-spacing:.34em;color:#9B9BA5">{{ trans('bav.brand_store_label') }}</span>
                </a>
                <p style="margin:22px 0 0;font-size:16px;line-height:1.9;color:#9B9BA5;max-width:360px">{{ theme.settings.get('footer_about_text') }}</p>
            </div>

            <div>
                <div style="font-weight:700;margin-bottom:14px">{{ trans('bav.nav.home') }}</div>
                <a class="flink" href="{{ store.url }}#choose-game">{{ trans('bav.nav.choose_game') }}</a>
                <a class="flink" href="{{ store.url }}#other-services">{{ trans('bav.nav.other_services') }}</a>
            </div>

            <div>
                <div style="font-weight:700;margin-bottom:14px">المساعدة</div>
                <a class="flink" href="{{ store.url }}#faq">{{ trans('bav.nav.faq') }}</a>
                <a class="flink" href="{{ store.url }}#how">{{ trans('bav.nav.how_to_find_id') }}</a>
                <salla-menu data-testid="store-footer-menu" source="footer" class="bav-footer-menu"></salla-menu>
            </div>

            <div>
                <div style="font-weight:700;margin-bottom:14px">الدفع</div>
                <salla-payments data-testid="store-footer-payments"></salla-payments>
            </div>
        </div>

        <div style="margin-top:56px;padding-top:24px;border-top:1px solid #1D1D22;font-size:14px;line-height:1.9;color:#7C7C86">
            <div>أسماء الألعاب والعلامات التجارية ملك لأصحابها، ولا يرتبط هذا المتجر بالجهات المطوّرة أو الناشرة لها.</div>
            <div dir="ltr" style="text-align:right;margin-top:6px">© 2026 {{ store.name }}</div>
        </div>

        <div class="bav-freelance-badge">
            <img src="{{ 'images/freelance-badge.svg'|asset }}" alt="شعار منصة العمل الحر" width="120" height="48" loading="lazy">
            <div>
                <span class="bav-freelance-badge__label">رمز الوثيقة المعتمدة</span>
                <span class="num bav-freelance-badge__code" dir="ltr">{{ theme.settings.get('freelance_doc_code') }}</span>
            </div>
        </div>
    </div>
</footer>

